{
  "format": "primlib.prim",
  "version": 1,
  "primitive": "hole",
  "title": "Screw hole",
  "params": [{"name": "hole_type", "default": "2", "note": "0 none, 1 plain, 2 countersunk, 3 counterbored", "group": null}, {"name": "thickness", "default": "5", "note": "plate thickness", "group": null}, {"name": "screw_diam", "default": "3", "note": "screw shank diameter", "group": null}, {"name": "head_diam", "default": "6", "note": "screw head diameter", "group": null}, {"name": "head_angle", "default": "90 deg", "note": "countersink included angle", "group": null}, {"name": "head_height", "default": "3", "note": "counterbore depth (screw head height)", "group": null}, {"name": "tolerance", "default": "0.1", "note": "clearance, normal to every face", "group": null}],
  "fixed": [],
  "derived": [{"name": "over", "expr": "0.5", "note": "overshoot past each plate face"}, {"name": "r_s", "expr": "screw_diam / 2 + tolerance", "note": "shank hole radius"}, {"name": "alpha", "expr": "90 deg - head_angle / 2", "note": "countersink flank to the face"}, {"name": "cs_r", "expr": "head_diam / 2 + tolerance / sin(alpha)", "note": "countersink radius at the top face"}, {"name": "cs_depth", "expr": "(cs_r - r_s) * tan(alpha)", "note": "countersink depth"}, {"name": "cb_r", "expr": "head_diam / 2 + tolerance", "note": "counterbore radius"}, {"name": "cb_depth", "expr": "head_height + tolerance", "note": "counterbore depth"}, {"name": "r_b", "expr": "hole_type == 2 ? cs_r : (hole_type == 3 ? cb_r : r_s)", "note": "radius at the top face"}, {"name": "z_a", "expr": "hole_type == 2 ? thickness - cs_depth : (hole_type == 3 ? thickness - cb_depth : thickness / 3)", "note": "top of the shank"}, {"name": "z_b", "expr": "hole_type == 2 ? thickness : (hole_type == 3 ? thickness - cb_depth : 2 * thickness / 3)", "note": "bottom of the full-width part"}],
  "checks": [{"expr": "hole_type < 0 ? 0 : (hole_type > 3 ? 0 : 1)", "message": "hole_type must be 0, 1, 2 or 3"}, {"expr": "thickness", "message": "thickness must be positive"}, {"expr": "screw_diam", "message": "screw_diam must be positive"}, {"expr": "head_diam - screw_diam", "message": "head_diam must exceed screw_diam"}, {"expr": "hole_type == 2 ? thickness - cs_depth : 1", "message": "the countersink is deeper than the plate"}, {"expr": "hole_type == 3 ? thickness - cb_depth : 1", "message": "the counterbore is deeper than the plate"}],
  "result": 0,
  "motion": [],
  "ops": [
    {"id": 0, "op": "revolve", "name": null, "points": [["0", "-(over)"], ["(r_s)", "-(over)"], ["(r_s)", "(z_a)"], ["(r_b)", "(z_b)"], ["(r_b)", "(thickness) + (over)"], ["0", "(thickness) + (over)"]], "span": ["0", "360"]}
  ]
}
