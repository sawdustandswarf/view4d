{
  "format": "primlib.prim",
  "version": 2,
  "kind": "assembly",
  "primitive": "hinged_lid",
  "title": "Hinged lid (example)",
  "params": [{"name": "run", "default": "120", "note": "each edge run's length", "group": null}, {"name": "key", "default": "'SFS", "note": "the runs' key", "group": null}, {"name": "hinge_length", "default": "40", "note": "the hinge's length, along x", "group": null}, {"name": "width", "default": "60", "note": "between the runs' axes", "group": null}, {"name": "open_angle", "default": "0", "note": "how far the lid side is open, degrees", "group": null}],
  "fixed": [],
  "derived": [{"name": "hinge_x", "expr": "(run - hinge_length) / 2", "note": "the hinge's start, centred on the runs"}],
  "checks": [{"expr": "run - hinge_length", "message": "the hinge is longer than the runs"}],
  "slots": 8,
  "result": 6,
  "motion": [],
  "parts": [
    {"name": "edges", "primitive": "edge_run", "bind": {"run": "run", "key": "key"}, "mirror": null, "colour": null, "pieces": null, "print": true},
    {"name": "lid_leaf", "primitive": "hinge", "bind": {"length": "hinge_length", "rings": "4"}, "mirror": null, "colour": [0.93, 0.66, 0.18], "pieces": ["side_a"], "print": true},
    {"name": "base_leaf", "primitive": "hinge", "bind": {"length": "hinge_length", "rings": "4"}, "mirror": null, "colour": [0.1, 0.62, 0.62], "pieces": ["side_b", "pins"], "print": false}
  ],
  "place": [
    {"id": 0, "op": "instance", "name": "base_run", "part": "edges", "at": ["0", "-width / 2", "0"], "turn": [{"axis": "y", "angle": "90"}]},
    {"id": 1, "op": "instance", "name": "hinge_base", "part": "base_leaf", "at": ["hinge_x", "0", "0"], "turn": [{"axis": "y", "angle": "90"}, {"axis": "x", "angle": "90"}]},
    {"id": 2, "op": "instance", "name": "lid_run", "part": "edges", "at": ["0", "width / 2", "0"], "turn": [{"axis": "y", "angle": "90"}]},
    {"id": 3, "op": "instance", "name": "hinge_lid", "part": "lid_leaf", "at": ["hinge_x", "0", "0"], "turn": [{"axis": "y", "angle": "90"}, {"axis": "x", "angle": "90"}]},
    {"id": 4, "op": "group", "name": "lid", "of": [2, 3]},
