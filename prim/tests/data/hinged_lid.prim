      "checks": [{"expr": "len(key) <= 7", "message": "key is longer than 7 letters"}, {"expr": "len(fallback) <= 7", "message": "fallback is longer than 7 letters"}, {"expr": "count(key; <<S>>) + count(key; <<M>>) + count(key; <<L>>) + count(key; <<F>>) == len(key)", "message": "key has a letter other than S M L F"}, {"expr": "count(fallback; <<S>>) + count(fallback; <<M>>) + count(fallback; <<L>>) + count(fallback; <<F>>) == len(fallback)", "message": "fallback has a letter other than S M L F"}, {"expr": "count(fallback; <<F>>)", "message": "fallback needs an F"}, {"expr": "fit_length >= min_fit", "message": "the run is too short, even with the fallback key"}],
