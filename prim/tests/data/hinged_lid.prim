    "hinge": {
      "format": "primlib.prim",
      "version": 1,
      "primitive": "hinge",
      "title": "Hinge",
      "params": [{"name": "length", "default": "40", "note": "along the axis", "group": "Main"}, {"name": "rings", "default": "4", "note": "rings, side A's the first and every other; at least 2", "group": "Main"}, {"name": "side_a", "default": "18", "note": "side A's side plate, beyond the tab (VerticalHinge3 18, 3b 7.5)", "group": "Main"}, {"name": "side_b", "default": "=side_a", "note": "side B's side plate: shorter to clear something on that side", "group": "Main"}, {"name": "pin_d", "default": "6", "note": "pin shaft diameter", "group": "Rings and pin"}, {"name": "pin_gap", "default": "0.5", "note": "pin to ring, radial", "group": "Rings and pin"}, {"name": "ring_wall", "default": "3", "note": "ring wall", "group": "Rings and pin"}, {"name": "ring_gap", "default": "0.1", "note": "between rings, along the axis", "group": "Rings and pin"}, {"name": "shear", "default": "0.05", "note": "width of a ring's pointed end", "group": "Rings and pin"}, {"name": "plate", "default": "14", "note": "the two tabs' width together, across the axis", "group": "Leaves and screws"}, {"name": "plate_t", "default": "5", "note": "leaf thickness", "group": "Leaves and screws"}, {"name": "plate_gap", "default": "1", "note": "between the two leaves' tabs", "group": "Leaves and screws"}, {"name": "backset", "default": "1", "note": "added to the rings' outside radius: the axis to the mounting face", "group": "Leaves and screws"}, {"name": "chamfer", "default": "0.5", "note": "45 degree chamfer on the leaves' square edges", "group": "Leaves and screws"}, {"name": "head_r", "default": "3.05", "note": "countersink radius and depth, at the leaf's outer face", "group": "Leaves and screws"}, {"name": "screw_r", "default": "1.7", "note": "screw hole radius", "group": "Leaves and screws"}, {"name": "screw_len", "default": "20", "note": "screw hole tool's length", "group": "Leaves and screws"}],
      "fixed": [],
      "derived": [{"name": "pitch", "expr": "length / rings", "note": "ring pitch"}, {"name": "r_pin", "expr": "pin_d / 2", "note": "pin radius"}, {"name": "r_in", "expr": "pin_d / 2 + pin_gap", "note": "ring bore radius"}, {"name": "r_out", "expr": "pin_d / 2 + pin_gap + ring_wall", "note": "ring outside radius"}, {"name": "face", "expr": "pin_d / 2 + pin_gap + ring_wall + backset", "note": "axis to the mounting faces"}],
      "checks": [{"expr": "rings - 1.5", "message": "a hinge needs at least two rings"}, {"expr": "length / rings - ring_gap - ring_wall", "message": "the rings are too short for their wall"}, {"expr": "plate / 2 - plate_gap / 2 + side_a - 2 * chamfer", "message": "side A's leaf is too short"}, {"expr": "plate / 2 - plate_gap / 2 + side_b - 2 * chamfer", "message": "side B's leaf is too short"}, {"expr": "plate_t - 2 * chamfer", "message": "the leaves are too thin for their chamfer"}],
      "result": 48,
      "motion": [],
      "ops": [
        {"id": 0, "op": "revolve", "name": "ring", "points": [["((r_in) + ring_wall / 2)", "0"], ["(r_out)", "(ring_wall / 2)"], ["(r_out)", "((pitch) - ring_gap) - (ring_wall / 2) + shear / 2"], ["((r_in) + ring_wall / 2) + shear / 2", "((pitch) - ring_gap)"], ["((r_in) + ring_wall / 2) - shear / 2", "((pitch) - ring_gap)"], ["(r_in)", "((pitch) - ring_gap) - (ring_wall / 2) + shear / 2"], ["(r_in)", "(ring_wall / 2)"]], "span": ["0", "360"]},
        {"id": 1, "op": "revolve", "name": "pin", "points": [["0", "0"], ["((r_pin) + ring_wall / 2)", "0"], ["(r_pin)", "(ring_wall / 2)"], ["(r_pin)", "(pitch) - (ring_wall / 2)"], ["((r_pin) + ring_wall / 2)", "(pitch)"], ["0", "(pitch)"]], "span": ["0", "360"]},
