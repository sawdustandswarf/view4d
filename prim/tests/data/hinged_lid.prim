        {"id": 3, "op": "array", "name": "rings_b", "base": 0, "along": {"z": {"count": "floor(rings / 2)", "start": "(pitch)", "step": "2 * (pitch)"}}},
        {"id": 4, "op": "array", "name": "pins", "base": 1, "along": {"z": {"count": "rings", "start": "0", "step": "(pitch)"}}},
