        {"id": 6, "op": "array", "name": "around_a", "base": 5, "along": {"z": {"count": "ceil(rings / 2)", "start": "0", "step": "2 * (pitch)"}}},
        {"id": 7, "op": "revolve", "name": "clear_b", "points": [["((r_in) + ring_wall / 2) - shear / 2", "(-pin_gap)"], ["((r_in) + ring_wall / 2) + shear / 2", "(-pin_gap)"], ["((r_out) + pin_gap)", "(-pin_gap) + (((r_out) + pin_gap) - ((r_in) + ring_wall / 2) + shear / 2)"], ["((r_out) + pin_gap)", "(((pitch) - ring_gap) + pin_gap) - (((r_out) + pin_gap) - ((r_in) + ring_wall / 2) + shear / 2)"], ["((r_in) + ring_wall / 2) + shear / 2", "(((pitch) - ring_gap) + pin_gap)"], ["((r_in) + ring_wall / 2) - shear / 2", "(((pitch) - ring_gap) + pin_gap)"], ["(r_pin)", "(((pitch) - ring_gap) + pin_gap) - (((r_out) + pin_gap) - ((r_in) + ring_wall / 2) + shear / 2)"], ["(r_pin)", "(-pin_gap) + (((r_out) + pin_gap) - ((r_in) + ring_wall / 2) + shear / 2)"]], "span": ["-90", "90"]},
        {"id": 8, "op": "array", "name": "around_b", "base": 7, "along": {"z": {"count": "floor(rings / 2)", "start": "(pitch)", "step": "2 * (pitch)"}}},
