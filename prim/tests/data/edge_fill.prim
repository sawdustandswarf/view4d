 hole tool's length from the outside face", "group": "Screws"}, {"name": "holes_x", "default": "1", "note": "1 for the row through the -x wall, 0 for none", "group": "Screws"}, {"name": "holes_y", "default": "1", "note": "1 for the row through the -y wall, 0 for none", "group": "Screws"}],
      "fixed": [],
      "derived": [{"name": "reach", "expr": "size - (panel_t + skin)", "note": "the walls' length from the inside corner"}, {"name": "inset", "expr": "panel_gap + drill_inset", "note": "the screw rows' line from the inside corner"}, {"name": "span", "expr": "length - 2 * drill_inset", "note": "between the end holes"}, {"name": "holes", "expr": "span < min_spacing ? 1 : ceil(span / nominal_spacing) + 1", "note": "holes per row"}],
