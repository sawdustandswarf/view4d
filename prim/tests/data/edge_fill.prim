{
  "format": "primlib.prim",
  "version": 2,
  "kind": "recipe",
  "primitive": "edge_fill",
  "title": "Edge fill",
  "params": [{"name": "span", "default": "300", "note": "the length to fill", "group": "Layout"}, {"name": "target", "default": "50", "note": "a big piece's length", "group": "Layout"}, {"name": "spacer", "default": "10", "note": "between pieces", "group": "Layout"}, {"name": "bigs", "default": "4", "note": "how many big pieces: even gives one odd piece, odd two", "group": "Layout"}, {"name": "littles", "default": "0", "note": "how many little pieces, half at each end: even", "group": "Layout"}, {"name": "little_length", "default": "20", "note": "a little piece's length", "group": "Layout"}, {"name": "end_spacers", "default": "1", "note": "1: a spacer at both ends too; 0: none", "group": "Layout"}, {"name": "min_part", "default": "20", "note": "the shortest odd piece allowed", "group": "Layout"}, {"name": "max_part", "default": "80", "note": "the longest odd piece allowed", "group": "Layout"}, {"name": "size", "default": "27", "note": "the edge's section, each way", "group": "Section"}, {"name": "panel_t", "default": "6.5", "note": "the panels' thickness", "group": "Section"}, {"name": "skin", "default": "5", "note": "the wall over the panels", "group": "Section"}, {"name": "panel_gap", "default": "3", "note": "the web's width", "group": "Section"}, {"name": "bevel", "default": "15", "note": "the outside bevel's width", "group": "Section"}],
  "fixed": [],
  "derived": [{"name": "odds", "expr": "mod(bigs; 2) == 1 ? 2 : 1", "note": "odd pieces: set by the bigs"}, {"name": "pieces", "expr": "bigs + littles + odds", "note": "pieces in all"}, {"name": "spacers", "expr": "pieces - 1 + 2 * end_spacers", "note": "spacers in all"}, {"name": "odd", "expr": "(span - bigs * target - littles * little_length - spacers * spacer) / odds", "note": "each odd piece's length"}, {"name": "key", "expr": "repeat(<<L>>; floor(littles / 2)) + repeat(<<B>>; floor(bigs / 2)) + (mod(bigs; 2) == 1 ? <<OBO>> : <<O>>) + repeat(<<B>>; floor(bigs / 2)) + repeat(<<L>>; floor(littles / 2))", "note": "the pieces in order: L little, B big, O odd"}],
  "checks": [{"expr": "mod(littles; 2) == 0", "message": "littles must be even"}, {"expr": "(bigs >= 0) * (floor(bigs) == bigs)", "message": "bigs must be a whole number, 0 or more"}, {"expr": "(littles >= 0) * (floor(littles) == littles)", "message": "littles must be a whole number, 0 or more"}, {"expr": "pieces <= 15", "message": "too many pieces: 15 at most"}, {"expr": "odd >= min_part", "message": "the odd piece is too short: fewer bigs, littles or spacers"}, {"expr": "odd <= max_part", "message": "the odd piece is too long: more bigs or littles"}],
  "slots": 15,
  "result": 0,
  "motion": [],
  "parts": [
    {"name": "big", "primitive": "box_edge", "bind": {"length": "target", "size": "size", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel"}, "mirror": null, "colour": [0.93, 0.66, 0.18], "pieces": null, "print": false},
    {"name": "odd", "primitive": "box_edge", "bind": {"length": "odd", "size": "size", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel"}, "mirror": null, "colour": [0.8, 0.8, 0.78], "pieces": null, "print": false},
    {"name": "little", "primitive": "box_edge", "bind": {"length": "little_length", "size": "size", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel"}, "mirror": null, "colour": [0.1, 0.62, 0.62], "pieces": null, "print": false}
  ],
  "place": [
    {"id": 0, "op": "row", "name": "edge", "key": "key", "pieces": {"B": {"part": "big", "length": "target"}, "O": {"part": "odd", "length": "odd"}, "L": {"part": "little", "length": "little_length"}}, "at": ["0", "0", "0"], "along": "z", "gap": "spacer", "lead": "end_spacers * spacer", "turn": []}
  ],
