{
  "format": "primlib.prim",
  "version": 1,
  "primitive": "topeak_rail_housing",
  "title": "Topeak rail housing",
  "params": [{"name": "clearance", "default": "0.30", "note": "the gap between the printed rail and housing, normal to every face, per side", "group": "Variable"}, {"name": "length", "default": "20", "note": "along x", "group": "Variable"}, {"name": "block_width", "default": "80", "note": "across, y", "group": "Variable"}, {"name": "block_depth", "default": "10", "note": "down from the mating face, z", "group": "Variable"}, {"name": "end_taper", "default": "0", "note": "lead-ins at both ends: 0 none; otherwise how far the profile changes at the very end, normal to its faces, over the same length along x, so at 45 deg", "group": "Variable"}, {"name": "printer_width_offset", "default": "0", "note": "added to the slot's width in the model, half to each side, so that the slot prints at its design width; the housing's own value, not part of the fit", "group": "Variable"}],
  "fixed": [{"name": "width", "expr": "61.4", "note": "the outside width, between vertical tangents to the tip radii, what calipers read on the print"}, {"name": "angle", "expr": "60", "note": "the slope of the sides, flank to the tip face, deg"}, {"name": "depth", "expr": "6.35", "note": "the depth of the tongue, root to tip (1/4\", set by the rack)"}, {"name": "tip_radius", "expr": "0.7", "note": "the radius of the two tip corners"}, {"name": "root_radius", "expr": "1", "note": "the radius of the two root corners"}, {"name": "groove_width", "expr": "19.95", "note": "the width of the centre groove at the tip face"}, {"name": "groove_depth", "expr": "1.2", "note": "the depth of the centre groove, up from the tip face"}, {"name": "groove_angle", "expr": "45", "note": "the slope of the groove's sides to the tip face, deg"}],
  "derived": [{"name": "t_tip", "expr": "tip_radius / tan(angle / 2)", "note": "tip radius's tangent length"}, {"name": "t_root", "expr": "root_radius / tan(angle / 2)", "note": "root radius's tangent length, into a base wider than the root"}, {"name": "tip_hw", "expr": "width / 2 + t_tip - tip_radius", "note": "tip half-width, sharp"}, {"name": "root_hw", "expr": "tip_hw - depth / tan(angle)", "note": "root half-width, sharp"}, {"name": "width_check", "expr": "2 * (tip_hw - t_tip + tip_radius)", "note": "the width, worked back from the sharp corners"}, {"name": "grow", "expr": "clearance / tan(angle / 2)", "note": "how far clearance moves the sharp corners"}, {"name": "floor_hw", "expr": "tip_hw + grow", "note": "slot floor half-width, sharp"}, {"name": "mouth_hw", "expr": "root_hw + grow", "note": "slot mouth half-width, sharp"}, {"name": "lip_end", "expr": "mouth_hw + t_root + 3", "note": "past the lip, over the mating face"}],
  "checks": [{"expr": "length", "message": "length must be positive"}, {"expr": "0.000001 - abs(width_check - width)", "message": "the tip radii don't come to the width"}, {"expr": "root_hw + printer_width_offset / 2", "message": "depth leaves no root"}, {"expr": "end_taper >= end_taper * 0 ? 1 : 0", "message": "end_taper can't be negative"}, {"expr": "tip_radius - end_taper", "message": "end_taper must be less than the tip radius"}, {"expr": "length - 2 * end_taper", "message": "length is too short for its two tapered ends"}, {"expr": "tip_hw - t_tip - groove_width / 2 - end_taper", "message": "the groove and the tip radii leave no tip face between them"}, {"expr": "clearance", "message": "clearance must be positive"}, {"expr": "block_depth - depth - end_taper", "message": "block_depth leaves no floor under the lead-ins"}, {"expr": "block_width / 2 - floor_hw - end_taper / tan(angle / 2) - printer_width_offset / 2", "message": "block_width leaves no wall beside the slot"}, {"expr": "groove_depth - clearance - end_taper", "message": "the guide is too low for its gap and lead-ins"}],
  "result": 4,
  "motion": [],
  "ops": [
    {"id": 0, "op": "box", "name": "block", "x": ["0", "length"], "y": ["-block_width / 2", "block_width / 2"], "z": ["-clearance - block_depth", "-clearance"]},
    {"id": 1, "op": "loft", "name": "slot", "plane": "yz", "ruled": true, "sections": [{"points": [["-((floor_hw + (end_taper + 0.2) / tan(angle / 2)) + printer_width_offset / 2)", "-depth - clearance - (end_taper + 0.2)", "tip_radius + clearance + (end_taper + 0.2)"], ["-(groove_width / 2 + (clearance + (end_taper + 0.2)) / tan(groove_angle) - (clearance + (end_taper + 0.2)) / sin(groove_angle))", "-depth - (clearance + (end_taper + 0.2))"], ["-(groove_width / 2 - (groove_depth - (clearance + (end_taper + 0.2))) / tan(groove_angle) - (clearance + (end_taper + 0.2)) / sin(groove_angle))", "-depth + groove_depth - (clearance + (end_taper + 0.2))"], ["groove_width / 2 - (groove_depth - (clearance + (end_taper + 0.2))) / tan(groove_angle) - (clearance + (end_taper + 0.2)) / sin(groove_angle)", "-depth + groove_depth - (clearance + (end_taper + 0.2))"], ["groove_width / 2 + (clearance + (end_taper + 0.2)) / tan(groove_angle) - (clearance + (end_taper + 0.2)) / sin(groove_angle)", "-depth - (clearance + (end_taper + 0.2))"], ["(floor_hw + (end_taper + 0.2) / tan(angle / 2)) + printer_width_offset / 2", "-depth - clearance - (end_taper + 0.2)", "tip_radius + clearance + (end_taper + 0.2)"], ["(mouth_hw + (end_taper + 0.2) / sin(angle)) + printer_width_offset / 2", "-clearance", "root_radius - clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance"], ["-((mouth_hw + (end_taper + 0.2) / sin(angle)) + printer_width_offset / 2)", "-clearance", "root_radius - clearance"]], "at": "-0.2"}, {"points": [["-((floor_hw + (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth - clearance - (0)", "tip_radius + clearance + (0)"], ["-(groove_width / 2 + (clearance + (0)) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle))", "-depth - (clearance + (0))"], ["-(groove_width / 2 - (groove_depth - (clearance + (0))) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle))", "-depth + groove_depth - (clearance + (0))"], ["groove_width / 2 - (groove_depth - (clearance + (0))) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle)", "-depth + groove_depth - (clearance + (0))"], ["groove_width / 2 + (clearance + (0)) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle)", "-depth - (clearance + (0))"], ["(floor_hw + (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth - clearance - (0)", "tip_radius + clearance + (0)"], ["(mouth_hw + (0) / sin(angle)) + printer_width_offset / 2", "-clearance", "root_radius - clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance"], ["-((mouth_hw + (0) / sin(angle)) + printer_width_offset / 2)", "-clearance", "root_radius - clearance"]], "at": "end_taper"}, {"points": [["-((floor_hw + (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth - clearance - (0)", "tip_radius + clearance + (0)"], ["-(groove_width / 2 + (clearance + (0)) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle))", "-depth - (clearance + (0))"], ["-(groove_width / 2 - (groove_depth - (clearance + (0))) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle))", "-depth + groove_depth - (clearance + (0))"], ["groove_width / 2 - (groove_depth - (clearance + (0))) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle)", "-depth + groove_depth - (clearance + (0))"], ["groove_width / 2 + (clearance + (0)) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle)", "-depth - (clearance + (0))"], ["(floor_hw + (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth - clearance - (0)", "tip_radius + clearance + (0)"], ["(mouth_hw + (0) / sin(angle)) + printer_width_offset / 2", "-clearance", "root_radius - clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance"], ["-((mouth_hw + (0) / sin(angle)) + printer_width_offset / 2)", "-clearance", "root_radius - clearance"]], "at": "length - end_taper"}, {"points": [["-((floor_hw + (end_taper + 0.2) / tan(angle / 2)) + printer_width_offset / 2)", "-depth - clearance - (end_taper + 0.2)", "tip_radius + clearance + (end_taper + 0.2)"], ["-(groove_width / 2 + (clearance + (end_taper + 0.2)) / tan(groove_angle) - (clearance + (end_taper + 0.2)) / sin(groove_angle))", "-depth - (clearance + (end_taper + 0.2))"], ["-(groove_width / 2 - (groove_depth - (clearance + (end_taper + 0.2))) / tan(groove_angle) - (clearance + (end_taper + 0.2)) / sin(groove_angle))", "-depth + groove_depth - (clearance + (end_taper + 0.2))"], ["groove_width / 2 - (groove_depth - (clearance + (end_taper + 0.2))) / tan(groove_angle) - (clearance + (end_taper + 0.2)) / sin(groove_angle)", "-depth + groove_depth - (clearance + (end_taper + 0.2))"], ["groove_width / 2 + (clearance + (end_taper + 0.2)) / tan(groove_angle) - (clearance + (end_taper + 0.2)) / sin(groove_angle)", "-depth - (clearance + (end_taper + 0.2))"], ["(floor_hw + (end_taper + 0.2) / tan(angle / 2)) + printer_width_offset / 2", "-depth - clearance - (end_taper + 0.2)", "tip_radius + clearance + (end_taper + 0.2)"], ["(mouth_hw + (end_taper + 0.2) / sin(angle)) + printer_width_offset / 2", "-clearance", "root_radius - clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance"], ["-((mouth_hw + (end_taper + 0.2) / sin(angle)) + printer_width_offset / 2)", "-clearance", "root_radius - clearance"]], "at": "length + 0.2"}]},
    {"id": 2, "op": "prism", "name": "slot", "points": [["-((floor_hw + (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth - clearance - (0)", "tip_radius + clearance + (0)"], ["-(groove_width / 2 + (clearance + (0)) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle))", "-depth - (clearance + (0))"], ["-(groove_width / 2 - (groove_depth - (clearance + (0))) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle))", "-depth + groove_depth - (clearance + (0))"], ["groove_width / 2 - (groove_depth - (clearance + (0))) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle)", "-depth + groove_depth - (clearance + (0))"], ["groove_width / 2 + (clearance + (0)) / tan(groove_angle) - (clearance + (0)) / sin(groove_angle)", "-depth - (clearance + (0))"], ["(floor_hw + (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth - clearance - (0)", "tip_radius + clearance + (0)"], ["(mouth_hw + (0) / sin(angle)) + printer_width_offset / 2", "-clearance", "root_radius - clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance"], ["(lip_end) + printer_width_offset / 2", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance + 1"], ["-((lip_end) + printer_width_offset / 2)", "-clearance"], ["-((mouth_hw + (0) / sin(angle)) + printer_width_offset / 2)", "-clearance", "root_radius - clearance"]], "plane": "yz", "span": ["-(1)", "length + 1"]},
    {"id": 3, "op": "choose", "name": null, "guard": "end_taper > 0", "then": 1, "otherwise": 2},
    {"id": 4, "op": "cut", "name": null, "base": 0, "tools": [3]}
  ]
}
