    {"id": 0, "op": "row", "name": "edge", "key": "use", "pieces": {"S": {"part": "S", "length": "small"}, "M": {"part": "M", "length": "medium"}, "L": {"part": "L", "length": "large"}, "F": {"part": "F", "length": "fit_length"}}, "at": ["0", "0", "0"], "along": "z", "gap": "gap", "lead": "lead_gap * gap", "turn": []}
