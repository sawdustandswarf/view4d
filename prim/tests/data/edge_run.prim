{
  "format": "primlib.prim",
  "version": 2,
  "kind": "recipe",
  "primitive": "edge_run",
  "title": "Edge run",
  "params": [{"name": "run", "default": "300", "note": "the length between the corners", "group": "Run"}, {"name": "key", "default": "'SFMF", "note": "the pieces in order: S, M, L fixed, F fit", "group": "Run"}, {"name": "fallback", "default": "'F", "note": "the key used when `key`'s fit piece is under min_fit", "group": "Run"}, {"name": "small", "default": "30", "note": "an S piece's length", "group": "Run"}, {"name": "medium", "default": "60", "note": "an M piece's length", "group": "Run"}, {"name": "large", "default": "90", "note": "an L piece's length", "group": "Run"}, {"name": "gap", "default": "0.2", "note": "between pieces, and between a piece and a corner", "group": "Run"}, {"name": "min_fit", "default": "10", "note": "the shortest fit piece", "group": "Run"}, {"name": "lead_gap", "default": "1", "note": "1: a gap before the first piece (at a corner); 0: flush", "group": "Run"}, {"name": "end_gap", "default": "1", "note": "1: a gap after the last piece (at a corner); 0: flush", "group": "Run"}, {"name": "size", "default": "27", "note": "the edge's section, each way", "group": "Section"}, {"name": "panel_t", "default": "6.5", "note": "the panels' thickness", "group": "Section"}, {"name": "skin", "default": "5", "note": "the wall over the panels", "group": "Section"}, {"name": "panel_gap", "default": "3", "note": "the web's width", "group": "Section"}, {"name": "bevel", "default": "15", "note": "the outside bevel's width", "group": "Section"}, {"name": "chamfer", "default": "0.5", "note": "on the outward square edges", "group": "Section"}, {"name": "glue", "default": "0", "note": "the glue line's pockets behind the ridges; 0 for none", "group": "Section"}, {"name": "glue_ridge", "default": "0.6", "note": "the ridges the panels sit on", "group": "Section"}, {"name": "drill_inset", "default": "6", "note": "the screw rows from the inside corner, past the web", "group": "Screws"}, {"name": "nominal_spacing", "default": "30", "note": "the longest pitch along a screw row", "group": "Screws"}, {"name": "min_spacing", "default": "7", "note": "under this between the end holes, one middle hole", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "the screw hole", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "the countersink at the outside face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "the countersink's depth", "group": "Screws"}, {"name": "screw_len", "default": "20", "note": "the hole's length from the outside face", "group": "Screws"}],
  "fixed": [],
  "derived": [{"name": "raw_fit", "expr": "count(key; <<F>>) > 0 ? (run - (len(key) - 1 + lead_gap + end_gap) * gap - count(key; <<S>>) * small - count(key; <<M>>) * medium - count(key; <<L>>) * large) / count(key; <<F>>) : 0", "note": "the fit length with the key as typed"}, {"name": "use", "expr": "raw_fit < min_fit ? fallback : key", "note": "the key in use: as typed, or the fallback"}, {"name": "fit_length", "expr": "count(use; <<F>>) > 0 ? (run - (len(use) - 1 + lead_gap + end_gap) * gap - count(use; <<S>>) * small - count(use; <<M>>) * medium - count(use; <<L>>) * large) / count(use; <<F>>) : 0", "note": "each fit piece's length"}],
  "checks": [{"expr": "len(key) <= 7", "message": "key is longer than 7 letters"}, {"expr": "len(fallback) <= 7", "message": "fallback is longer than 7 letters"}, {"expr": "count(key; <<S>>) + count(key; <<M>>) + count(key; <<L>>) + count(key; <<F>>) == len(key)", "message": "key has a letter other than S M L F"}, {"expr": "count(fallback; <<S>>) + count(fallback; <<M>>) + count(fallback; <<L>>) + count(fallback; <<F>>) == len(fallback)", "message": "fallback has a letter other than S M L F"}, {"expr": "count(fallback; <<F>>)", "message": "fallback needs an F"}, {"expr": "fit_length >= min_fit", "message": "the run is too short, even with the fallback key"}],
  "slots": 7,
  "result": 0,
  "motion": [],
