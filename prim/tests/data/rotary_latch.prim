{
  "format": "primlib.prim",
  "version": 1,
  "primitive": "rotary_latch",
  "title": "Rotary latch",
  "params": [{"name": "knob_af", "default": "56", "note": "knob, a hexagon: across the flats (a flat at 12 o'clock, open)", "group": "Latch"}, {"name": "knob_len", "default": "11", "note": "knob length, rib tips to front face, z", "group": "Latch"}, {"name": "rail_r", "default": "15", "note": "the rail's centre line, radius about the pin", "group": "Latch"}, {"name": "rail_span", "default": "60", "note": "the rail's arc, centred at 12 o'clock, deg", "group": "Latch"}, {"name": "turn", "default": "90", "note": "knob turn from open to locked, either way, deg", "group": "Latch"}, {"name": "pull_down", "default": "1", "note": "how far a ramp draws the rail (and lid) down", "group": "Latch"}, {"name": "preload", "default": "0.5", "note": "mounted, the lid plate sits this far above locked: locking pulls it in; pull_down - preload is left for tolerance", "group": "Latch"}, {"name": "joint_y", "default": "7.6", "note": "axis to the lid joint: the middle of the gap between the plates, mounted", "group": "Latch"}, {"name": "clearance", "default": "0.2", "note": "every gap between parts, normal to the faces", "group": "Latch"}, {"name": "plate_t", "default": "3", "note": "base plate thickness, z", "group": "Base and knob"}, {"name": "plate_w", "default": "80", "note": "both plates' width, x", "group": "Base and knob"}, {"name": "plate_bot", "default": "-27", "note": "base plate's lower edge, y", "group": "Base and knob"}, {"name": "screw_x", "default": "36", "note": "axis to every screw, x (both plates: the screws line up)", "group": "Base and knob"}, {"name": "screw_y1", "default": "0", "note": "base plate's upper screws, y", "group": "Base and knob"}, {"name": "screw_y2", "default": "-20", "note": "base plate's lower screws, y", "group": "Base and knob"}, {"name": "screw_d", "default": "3.4", "note": "M3 clearance hole", "group": "Base and knob"}, {"name": "head_d", "default": "6", "note": "M3 countersink diameter at the face", "group": "Base and knob"}, {"name": "root_r", "default": "1", "note": "pin root, 45 deg", "group": "Base and knob"}, {"name": "wall_in", "default": "1.5", "note": "knob wall between bore and groove: sets the pin, as big as fits", "group": "Base and knob"}, {"name": "pilot_d", "default": "2.5", "note": "pilot hole in the pin for the M3 cap screw", "group": "Base and knob"}, {"name": "pilot_l", "default": "6", "note": "pilot hole depth", "group": "Base and knob"}, {"name": "ring_r1", "default": "7", "note": "inner V rib's tip radius", "group": "Base and knob"}, {"name": "ring_r2", "default": "23.5", "note": "outer V rib's tip radius (outside the groove)", "group": "Base and knob"}, {"name": "ring_h", "default": "1", "note": "V rib height (45 deg flanks)", "group": "Base and knob"}, {"name": "tip_w", "default": "0.2", "note": "V rib tip's flat", "group": "Base and knob"}, {"name": "cap_d", "default": "15", "note": "cap diameter", "group": "Base and knob"}, {"name": "cap_t", "default": "2", "note": "cap thickness", "group": "Base and knob"}, {"name": "depth", "default": "4", "note": "rail15 depth, root to tip", "group": "Rail"}, {"name": "base_depth", "default": "1", "note": "rail15 support under the root, into the lid plate", "group": "Rail"}, {"name": "ramp_a", "default": "20", "note": "each lead-in ramp's length from the notch's edge, deg", "group": "Rail"}, {"name": "lid_h", "default": "24", "note": "lid plate height, y, up from its lower edge", "group": "Lid plate"}, {"name": "lid_screw_in", "default": "5", "note": "lid plate's screws, in from its lower and upper edges, y", "group": "Lid plate"}, {"name": "bridge_t", "default": "0.2", "note": "alignment bridge: one layer", "group": "Print"}, {"name": "bridge_lap", "default": "1", "note": "alignment bridge: how far it runs under each plate", "group": "Print"}],
  "fixed": [{"name": "width", "expr": "15", "note": "the outside width, between vertical tangents to the tip radii, what calipers read"}, {"name": "angle", "expr": "60", "note": "the slope of the sides, flank to the tip face, deg"}, {"name": "tip_radius", "expr": "1", "note": "the radius of the two tip corners"}, {"name": "root_radius", "expr": "0.2", "note": "the radius of the two root corners"}],
  "derived": [{"name": "printer_width_offset", "expr": "0", "note": "rail15: no offset (its print measured 14.95)"}, {"name": "t_tip", "expr": "tip_radius / tan(angle / 2)", "note": "tip radius's tangent length"}, {"name": "t_root", "expr": "root_radius / tan(angle / 2)", "note": "root radius's tangent length, into a base wider than the root"}, {"name": "tip_hw", "expr": "width / 2 + t_tip - tip_radius", "note": "tip half-width, sharp"}, {"name": "root_hw", "expr": "tip_hw - depth / tan(angle)", "note": "root half-width, sharp"}, {"name": "width_check", "expr": "2 * (tip_hw - t_tip + tip_radius)", "note": "the width, worked back from the sharp corners"}, {"name": "base_hw", "expr": "root_hw + t_root", "note": "rail15: support half-width"}, {"name": "pin_d", "expr": "2 * (rail_r - width / 2 - clearance - wall_in - clearance)", "note": "pin diameter: the largest leaving wall_in between bore and slot"}, {"name": "knob_rc", "expr": "knob_af / 2 / cos(30)", "note": "knob's corners, radius (its sweep)"}, {"name": "gap_r", "expr": "clearance * sqrt(2)", "note": "radial gap that is clearance normal to a 45 deg face"}, {"name": "z_body", "expr": "plate_t + ring_h", "note": "the knob's back face"}, {"name": "z_front", "expr": "plate_t + knob_len", "note": "the knob's front face"}, {"name": "z_pin_top", "expr": "z_front - cap_t", "note": "the pin's end"}, {"name": "z_shoulder", "expr": "z_pin_top - clearance * (sqrt(2) - 1)", "note": "counterbore floor at its wall"}, {"name": "bore_r", "expr": "pin_d / 2 + clearance", "note": "knob bore radius"}, {"name": "cap_wall", "expr": "cap_d / 2 - bore_r", "note": "cap overlap on the counterbore's floor"}, {"name": "grow", "expr": "clearance / tan(angle / 2)", "note": "slot: how far clearance moves the sharp corners"}, {"name": "floor_hw", "expr": "tip_hw + grow", "note": "slot floor half-width, sharp"}, {"name": "mouth_hw", "expr": "root_hw + grow", "note": "slot mouth half-width, sharp"}, {"name": "root_z", "expr": "z_body - clearance", "note": "rail root: the lid plate's face"}, {"name": "z_floor", "expr": "root_z + depth + clearance", "note": "slot floor"}, {"name": "groove_in", "expr": "rail_r - width / 2 - clearance", "note": "slot's inner wall at its widest"}, {"name": "groove_out", "expr": "rail_r + width / 2 + clearance", "note": "slot's outer wall at its widest"}, {"name": "mouth_in", "expr": "rail_r - mouth_hw", "note": "slot mouth, inner edge"}, {"name": "mouth_out", "expr": "rail_r + mouth_hw", "note": "slot mouth, outer edge (the lip)"}, {"name": "notch_x", "expr": "(rail_r + width / 2) * sin(rail_span / 2) + clearance", "note": "notch half-width"}, {"name": "notch_a", "expr": "asin(notch_x / mouth_out) / 1deg", "note": "notch edge's angle from 12 o'clock at the lip"}, {"name": "ecc", "expr": "pull_down / sin(ramp_a)", "note": "ramp circle's offset from the axis"}, {"name": "ecc_a", "expr": "notch_a + ramp_a - 90", "note": "its direction, from 12 o'clock towards the ramp"}, {"name": "margin", "expr": "turn - notch_a - ramp_a - rail_span / 2", "note": "locked: the ramp's end past the rail's end, deg"}, {"name": "spare", "expr": "pull_down - preload", "note": "ramp left for tolerance, mounted"}, {"name": "base_top", "expr": "joint_y - clearance - preload / 2", "note": "base plate's upper edge"}, {"name": "lid_bot", "expr": "joint_y + clearance + preload / 2", "note": "lid plate's lower edge, mounted"}, {"name": "rail_low", "expr": "(rail_r - base_hw) * cos(rail_span / 2) + preload", "note": "the rail root's lowest point, mounted"}],
  "checks": [{"expr": "knob_af / 2 - 0.3 - ring_r2 - tip_w / 2", "message": "the outer rib isn't under the knob"}, {"expr": "ring_r2 - tip_w / 2 - mouth_out - 0.3", "message": "the outer rib isn't outside the slot"}, {"expr": "mouth_in - 0.3 - ring_r1 - tip_w / 2", "message": "the inner rib isn't inside the slot"}, {"expr": "ring_r1 - tip_w / 2 - pin_d / 2 - gap_r - 0.5", "message": "the inner rib doesn't clear the bore"}, {"expr": "cap_wall - 1.5 + 0.000001", "message": "the cap overlaps the floor by less than 1.5"}, {"expr": "z_pin_top - plate_t - pilot_l", "message": "the pilot hole reaches the plate"}, {"expr": "wall_in", "message": "wall_in must be positive"}, {"expr": "knob_af / 2 - groove_out - pull_down - 2.5 + 0.000001", "message": "less than 2.5 of wall outside the slot at a ramp"}, {"expr": "z_front - z_floor - 2 + 0.000001", "message": "less than 2 of knob in front of the slot"}, {"expr": "rail_low - lid_bot + 0.000001", "message": "the rail's root reaches below the lid plate"}, {"expr": "base_top - pin_d / 2 - root_r - 0.5 + 0.000001", "message": "the base plate doesn't reach 0.5 past the pin's root"}, {"expr": "margin - 3 + 0.000001", "message": "locked, the rail isn't 3 deg past the ramp"}, {"expr": "screw_x - head_d / 2 - knob_rc", "message": "the screw heads are under the knob's corners"}, {"expr": "-plate_bot - ring_r2 - tip_w / 2 - ring_h - 0.5 + 0.000001", "message": "the base plate doesn't carry the outer rib"}, {"expr": "screw_y2 - head_d / 2 - plate_bot", "message": "the lower base screws are off the plate"}, {"expr": "base_top - screw_y1 - head_d / 2", "message": "the upper base screws are off the plate"}, {"expr": "lid_h - 2 * lid_screw_in - head_d", "message": "the lid plate's screws overlap"}, {"expr": "lid_screw_in - head_d / 2", "message": "the lid plate's screws are off its edge"}, {"expr": "spare", "message": "preload must be less than pull_down"}, {"expr": "preload + 0.000001", "message": "preload can't be negative"}, {"expr": "bridge_t", "message": "bridge_t must be positive"}],
  "result": 67,
  "motion": [],
  "ops": [
    {"id": 0, "op": "box", "name": "base_plate", "x": ["-plate_w / 2", "plate_w / 2"], "y": ["plate_bot", "base_top"], "z": ["0", "plate_t"]},
    {"id": 1, "op": "cylinder", "name": "base_pin_shaft", "axis": "z", "centre": ["0", "0"], "r": "pin_d / 2", "span": ["plate_t - 0.5", "z_pin_top"]},
    {"id": 2, "op": "cone", "name": "base_pin_root", "axis": "z", "centre": ["0", "0"], "r1": "pin_d / 2 + root_r + 0.5", "r2": "pin_d / 2", "span": ["plate_t - 0.5", "plate_t + root_r"]},
    {"id": 3, "op": "fuse", "name": "base_pin_body", "of": [1, 2]},
    {"id": 4, "op": "cylinder", "name": "base_pilot", "axis": "z", "centre": ["0", "0"], "r": "pilot_d / 2", "span": ["z_pin_top - pilot_l", "z_pin_top + 1"]},
    {"id": 5, "op": "cut", "name": "base_pin", "base": 3, "tools": [4]},
    {"id": 6, "op": "cone", "name": "base_rib1_out", "axis": "z", "centre": ["0", "0"], "r1": "ring_r1 + tip_w / 2 + ring_h + 0.01", "r2": "ring_r1 + tip_w / 2", "span": ["plate_t - 0.01", "z_body"]},
    {"id": 7, "op": "cone", "name": "base_rib1_in", "axis": "z", "centre": ["0", "0"], "r1": "ring_r1 - tip_w / 2 - ring_h - 0.01", "r2": "ring_r1 - tip_w / 2", "span": ["plate_t - 0.01", "z_body"]},
    {"id": 8, "op": "cut", "name": "base_rib1", "base": 6, "tools": [7]},
    {"id": 9, "op": "cone", "name": "base_rib2_out", "axis": "z", "centre": ["0", "0"], "r1": "ring_r2 + tip_w / 2 + ring_h + 0.01", "r2": "ring_r2 + tip_w / 2", "span": ["plate_t - 0.01", "z_body"]},
    {"id": 10, "op": "cone", "name": "base_rib2_in", "axis": "z", "centre": ["0", "0"], "r1": "ring_r2 - tip_w / 2 - ring_h - 0.01", "r2": "ring_r2 - tip_w / 2", "span": ["plate_t - 0.01", "z_body"]},
    {"id": 11, "op": "cut", "name": "base_rib2", "base": 9, "tools": [10]},
    {"id": 12, "op": "fuse", "name": "base_rib_rings", "of": [8, 11]},
    {"id": 13, "op": "box", "name": "base_rib_clip", "x": ["-plate_w", "plate_w"], "y": ["plate_bot", "base_top"], "z": ["0", "z_body + 1"]},
    {"id": 14, "op": "common", "name": "base_ribs", "of": [12, 13]},
    {"id": 15, "op": "cylinder", "name": "base_hole0_shank", "axis": "z", "centre": ["-screw_x", "screw_y1"], "r": "screw_d / 2", "span": ["-1", "(plate_t) + 1"]},
    {"id": 16, "op": "cone", "name": "base_hole0_sink", "axis": "z", "centre": ["-screw_x", "screw_y1"], "r1": "screw_d / 2", "r2": "head_d / 2 + 1", "span": ["(plate_t) - (head_d - screw_d) / 2", "(plate_t) + 1"]},
    {"id": 17, "op": "cylinder", "name": "base_hole1_shank", "axis": "z", "centre": ["screw_x", "screw_y1"], "r": "screw_d / 2", "span": ["-1", "(plate_t) + 1"]},
    {"id": 18, "op": "cone", "name": "base_hole1_sink", "axis": "z", "centre": ["screw_x", "screw_y1"], "r1": "screw_d / 2", "r2": "head_d / 2 + 1", "span": ["(plate_t) - (head_d - screw_d) / 2", "(plate_t) + 1"]},
    {"id": 19, "op": "cylinder", "name": "base_hole2_shank", "axis": "z", "centre": ["-screw_x", "screw_y2"], "r": "screw_d / 2", "span": ["-1", "(plate_t) + 1"]},
    {"id": 20, "op": "cone", "name": "base_hole2_sink", "axis": "z", "centre": ["-screw_x", "screw_y2"], "r1": "screw_d / 2", "r2": "head_d / 2 + 1", "span": ["(plate_t) - (head_d - screw_d) / 2", "(plate_t) + 1"]},
    {"id": 21, "op": "cylinder", "name": "base_hole3_shank", "axis": "z", "centre": ["screw_x", "screw_y2"], "r": "screw_d / 2", "span": ["-1", "(plate_t) + 1"]},
    {"id": 22, "op": "cone", "name": "base_hole3_sink", "axis": "z", "centre": ["screw_x", "screw_y2"], "r1": "screw_d / 2", "r2": "head_d / 2 + 1", "span": ["(plate_t) - (head_d - screw_d) / 2", "(plate_t) + 1"]},
    {"id": 23, "op": "fuse", "name": "base_body", "of": [0, 5, 14]},
    {"id": 24, "op": "cut", "name": "base", "base": 23, "tools": [15, 16, 17, 18, 19, 20, 21, 22]},
    {"id": 25, "op": "polygon", "name": "knob_hexagon", "sides": 6, "r": "knob_rc", "span": ["z_body", "z_front"]},
    {"id": 26, "op": "cylinder", "name": "knob_bore", "axis": "z", "centre": ["0", "0"], "r": "bore_r", "span": ["plate_t - 1", "z_front + 1"]},
    {"id": 27, "op": "cone", "name": "knob_bore_chamfer", "axis": "z", "centre": ["0", "0"], "r1": "pin_d / 2 + root_r + gap_r + 1", "r2": "pin_d / 2 + gap_r", "span": ["plate_t - 1", "plate_t + root_r"]},
    {"id": 28, "op": "cylinder", "name": "knob_counterbore", "axis": "z", "centre": ["0", "0"], "r": "cap_d / 2 + clearance", "span": ["z_shoulder", "z_front + 1"]},
    {"id": 29, "op": "cone", "name": "knob_counterbore_floor", "axis": "z", "centre": ["0", "0"], "r1": "bore_r - 0.5", "r2": "cap_d / 2 + clearance", "span": ["z_shoulder - (cap_d / 2 + clearance - bore_r) - 0.5", "z_shoulder"]},
    {"id": 30, "op": "revolve", "name": "knob_slot", "points": [["rail_r + (-((floor_hw) + printer_width_offset / 2))", "root_z - (-depth - clearance)", "tip_radius + clearance"], ["rail_r + ((floor_hw) + printer_width_offset / 2)", "root_z - (-depth - clearance)", "tip_radius + clearance"], ["rail_r + ((mouth_hw) + printer_width_offset / 2)", "root_z - (-clearance)", "root_radius - clearance"], ["rail_r + ((mouth_hw + t_root + 1) + printer_width_offset / 2)", "root_z - (-clearance)"], ["rail_r + ((mouth_hw + t_root + 1) + printer_width_offset / 2)", "root_z - (-clearance + 1)"], ["rail_r + (-((mouth_hw + t_root + 1) + printer_width_offset / 2))", "root_z - (-clearance + 1)"], ["rail_r + (-((mouth_hw + t_root + 1) + printer_width_offset / 2))", "root_z - (-clearance)"], ["rail_r + (-((mouth_hw) + printer_width_offset / 2))", "root_z - (-clearance)", "root_radius - clearance"]], "span": ["0", "360"]},
    {"id": 31, "op": "revolve", "name": "knob_ramp_r_slot", "points": [["rail_r + (-((floor_hw) + printer_width_offset / 2))", "root_z - (-depth - clearance)", "tip_radius + clearance"], ["rail_r + ((floor_hw) + printer_width_offset / 2)", "root_z - (-depth - clearance)", "tip_radius + clearance"], ["rail_r + ((mouth_hw) + printer_width_offset / 2)", "root_z - (-clearance)", "root_radius - clearance"], ["rail_r + ((mouth_hw + t_root + 1) + printer_width_offset / 2)", "root_z - (-clearance)"], ["rail_r + ((mouth_hw + t_root + 1) + printer_width_offset / 2)", "root_z - (-clearance + 1)"], ["rail_r + (-((mouth_hw + t_root + 1) + printer_width_offset / 2))", "root_z - (-clearance + 1)"], ["rail_r + (-((mouth_hw + t_root + 1) + printer_width_offset / 2))", "root_z - (-clearance)"], ["rail_r + (-((mouth_hw) + printer_width_offset / 2))", "root_z - (-clearance)", "root_radius - clearance"]], "span": ["0", "360"]},
    {"id": 32, "op": "move", "name": null, "base": 31, "by": ["ecc * sin(ecc_a)", "ecc * cos(ecc_a)", null]},
    {"id": 33, "op": "sector", "name": "knob_ramp_r_sector", "r": "knob_rc + 2", "span": ["z_body - 1", "z_floor + 0.5"], "start": "90 - notch_a - ramp_a", "angle": "ramp_a + 5"},
    {"id": 34, "op": "cylinder", "name": "knob_ramp_r_inner", "axis": "z", "centre": ["0", "0"], "r": "rail_r", "span": ["z_body - 2", "z_floor + 2"]},
    {"id": 35, "op": "cut", "name": "knob_ramp_r_zone", "base": 33, "tools": [34]},
    {"id": 36, "op": "common", "name": "knob_ramp_r", "of": [32, 35]},
    {"id": 37, "op": "revolve", "name": "knob_ramp_l_slot", "points": [["rail_r + (-((floor_hw) + printer_width_offset / 2))", "root_z - (-depth - clearance)", "tip_radius + clearance"], ["rail_r + ((floor_hw) + printer_width_offset / 2)", "root_z - (-depth - clearance)", "tip_radius + clearance"], ["rail_r + ((mouth_hw) + printer_width_offset / 2)", "root_z - (-clearance)", "root_radius - clearance"], ["rail_r + ((mouth_hw + t_root + 1) + printer_width_offset / 2)", "root_z - (-clearance)"], ["rail_r + ((mouth_hw + t_root + 1) + printer_width_offset / 2)", "root_z - (-clearance + 1)"], ["rail_r + (-((mouth_hw + t_root + 1) + printer_width_offset / 2))", "root_z - (-clearance + 1)"], ["rail_r + (-((mouth_hw + t_root + 1) + printer_width_offset / 2))", "root_z - (-clearance)"], ["rail_r + (-((mouth_hw) + printer_width_offset / 2))", "root_z - (-clearance)", "root_radius - clearance"]], "span": ["0", "360"]},
    {"id": 38, "op": "move", "name": null, "base": 37, "by": ["-ecc * sin(ecc_a)", "ecc * cos(ecc_a)", null]},
    {"id": 39, "op": "sector", "name": "knob_ramp_l_sector", "r": "knob_rc + 2", "span": ["z_body - 1", "z_floor + 0.5"], "start": "90 + notch_a - 5", "angle": "ramp_a + 5"},
    {"id": 40, "op": "cylinder", "name": "knob_ramp_l_inner", "axis": "z", "centre": ["0", "0"], "r": "rail_r", "span": ["z_body - 2", "z_floor + 2"]},
    {"id": 41, "op": "cut", "name": "knob_ramp_l_zone", "base": 39, "tools": [40]},
    {"id": 42, "op": "common", "name": "knob_ramp_l", "of": [38, 41]},
    {"id": 43, "op": "box", "name": "knob_notch_box", "x": ["-notch_x", "notch_x"], "y": ["0", "knob_rc + 2"], "z": ["z_body - 1", "z_floor"]},
    {"id": 44, "op": "cylinder", "name": "knob_notch_keep", "axis": "z", "centre": ["0", "0"], "r": "mouth_in", "span": ["z_body - 2", "z_floor + 2"]},
    {"id": 45, "op": "cut", "name": "knob_notch", "base": 43, "tools": [44]},
    {"id": 46, "op": "cut", "name": "knob", "base": 25, "tools": [26, 27, 28, 29, 30, 36, 42, 45]},
    {"id": 47, "op": "cylinder", "name": "cap_disc", "axis": "z", "centre": ["0", "0"], "r": "cap_d / 2", "span": ["z_pin_top", "z_front"]},
    {"id": 48, "op": "cylinder", "name": "cap_hole_shank", "axis": "z", "centre": ["0", "0"], "r": "screw_d / 2", "span": ["-1", "(z_front) + 1"]},
    {"id": 49, "op": "cone", "name": "cap_hole_sink", "axis": "z", "centre": ["0", "0"], "r1": "screw_d / 2", "r2": "head_d / 2 + 1", "span": ["(z_front) - (head_d - screw_d) / 2", "(z_front) + 1"]},
    {"id": 50, "op": "cut", "name": "cap", "base": 47, "tools": [48, 49]},
    {"id": 51, "op": "revolve", "name": "lid_rail_arc", "points": [["rail_r + (-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2))", "root_z - (-depth + (0))", "tip_radius - (0)"], ["rail_r + ((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "root_z - (-depth + (0))", "tip_radius - (0)"], ["rail_r + ((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "root_z - (0)", "root_radius"], ["rail_r + ((base_hw + 1) + printer_width_offset / 2)", "root_z - (0)"], ["rail_r + ((base_hw + 1) + printer_width_offset / 2)", "root_z - (base_depth)"], ["rail_r + (-((base_hw + 1) + printer_width_offset / 2))", "root_z - (base_depth)"], ["rail_r + (-((base_hw + 1) + printer_width_offset / 2))", "root_z - (0)"], ["rail_r + (-((root_hw - (0) / sin(angle)) + printer_width_offset / 2))", "root_z - (0)", "root_radius"]], "span": ["90 - rail_span / 2", "90 + rail_span / 2"]},
    {"id": 52, "op": "move", "name": null, "base": 51, "by": [null, "preload", null]},
