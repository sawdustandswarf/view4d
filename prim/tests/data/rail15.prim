{
  "format": "primlib.prim",
  "version": 1,
  "primitive": "rail15",
  "title": "15 mm rail",
  "params": [{"name": "length", "default": "20", "note": "along x", "group": "Variable"}, {"name": "depth", "default": "4", "note": "the depth of the tapered part, root to tip", "group": "Variable"}, {"name": "base_depth", "default": "1", "note": "the depth of the support on the root, up from it", "group": "Variable"}, {"name": "base_width", "default": "-1", "note": "the width of the support; -1 (any negative): as wide as the root including its radius", "group": "Variable"}, {"name": "end_taper", "default": "0", "note": "lead-ins at both ends: 0 none; otherwise how far the profile changes at the very end, normal to its faces, over the same length along x, so at 45 deg", "group": "Variable"}, {"name": "printer_width_offset", "default": "0", "note": "added to the width in the model, half to each side, so that the part prints at its design width; not part of the fit", "group": "Variable"}],
  "fixed": [{"name": "width", "expr": "15", "note": "the outside width, between vertical tangents to the tip radii, what calipers read"}, {"name": "angle", "expr": "60", "note": "the slope of the sides, flank to the tip face, deg"}, {"name": "tip_radius", "expr": "1", "note": "the radius of the two tip corners"}, {"name": "root_radius", "expr": "0.2", "note": "the radius of the two root corners"}],
  "derived": [{"name": "t_tip", "expr": "tip_radius / tan(angle / 2)", "note": "tip radius's tangent length"}, {"name": "t_root", "expr": "root_radius / tan(angle / 2)", "note": "root radius's tangent length, into a base wider than the root"}, {"name": "tip_hw", "expr": "width / 2 + t_tip - tip_radius", "note": "tip half-width, sharp"}, {"name": "root_hw", "expr": "tip_hw - depth / tan(angle)", "note": "root half-width, sharp"}, {"name": "width_check", "expr": "2 * (tip_hw - t_tip + tip_radius)", "note": "the width, worked back from the sharp corners"}, {"name": "base_hw", "expr": "base_width < base_width * 0 ? root_hw + t_root : base_width / 2", "note": "the support's half-width"}],
  "checks": [{"expr": "length", "message": "length must be positive"}, {"expr": "0.000001 - abs(width_check - width)", "message": "the tip radii don't come to the width"}, {"expr": "root_hw + printer_width_offset / 2", "message": "depth leaves no root"}, {"expr": "end_taper >= end_taper * 0 ? 1 : 0", "message": "end_taper can't be negative"}, {"expr": "tip_radius - end_taper", "message": "end_taper must be less than the tip radius"}, {"expr": "length - 2 * end_taper", "message": "length is too short for its two tapered ends"}, {"expr": "(depth - end_taper) / sin(angle) - (tip_radius - end_taper) / tan(angle / 2) - t_root", "message": "depth is too small for end_taper: the flanks are too short for their radii"}, {"expr": "depth / sin(angle) - t_tip - t_root", "message": "depth is too small: the flanks are too short for their radii"}, {"expr": "base_depth", "message": "base_depth must be more than 0: the root radius needs the support"}, {"expr": "base_width < base_width * 0 ? 1 : base_width / 2 - root_hw - t_root", "message": "base_width is narrower than the root and its radius"}],
  "result": 9,
  "motion": [],
  "ops": [
    {"id": 0, "op": "loft", "name": null, "plane": "yz", "ruled": true, "sections": [{"points": [["-((tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "0"}, {"points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "end_taper"}, {"points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "length - end_taper"}, {"points": [["-((tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "length"}]},
    {"id": 1, "op": "prism", "name": null, "points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "plane": "yz", "span": ["0", "length"]},
    {"id": 2, "op": "choose", "name": null, "guard": "end_taper > 0", "then": 0, "otherwise": 1},
    {"id": 3, "op": "loft", "name": "rail", "plane": "yz", "ruled": true, "sections": [{"points": [["-((tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw + 1) + printer_width_offset / 2", "0"], ["(base_hw + 1) + printer_width_offset / 2", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "0"], ["-((root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "0"}, {"points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw + 1) + printer_width_offset / 2", "0"], ["(base_hw + 1) + printer_width_offset / 2", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "end_taper"}, {"points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw + 1) + printer_width_offset / 2", "0"], ["(base_hw + 1) + printer_width_offset / 2", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "length - end_taper"}, {"points": [["-((tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw + 1) + printer_width_offset / 2", "0"], ["(base_hw + 1) + printer_width_offset / 2", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "0"], ["-((root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "length"}]},
    {"id": 4, "op": "prism", "name": "rail", "points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw + 1) + printer_width_offset / 2", "0"], ["(base_hw + 1) + printer_width_offset / 2", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "plane": "yz", "span": ["0", "length"]},
    {"id": 5, "op": "choose", "name": null, "guard": "end_taper > 0", "then": 3, "otherwise": 4},
    {"id": 6, "op": "box", "name": "trim_right", "x": ["-1", "length + 1"], "y": ["(base_hw) + printer_width_offset / 2", "(base_hw + 2) + printer_width_offset / 2"], "z": ["0", "base_depth + 1"]},
    {"id": 7, "op": "box", "name": "trim_left", "x": ["-1", "length + 1"], "y": ["-((base_hw + 2) + printer_width_offset / 2)", "-((base_hw) + printer_width_offset / 2)"], "z": ["0", "base_depth + 1"]},
    {"id": 8, "op": "cut", "name": null, "base": 5, "tools": [6, 7]},
    {"id": 9, "op": "choose", "name": null, "guard": "base_width >= 0", "then": 2, "otherwise": 8}
  ]
}
