{
  "format": "primlib.prim",
  "version": 1,
  "primitive": "plate",
  "title": "Plate",
  "params": [{"name": "length", "default": "40", "note": "size along x", "group": null}, {"name": "width", "default": "20", "note": "size along y", "group": null}, {"name": "thickness", "default": "5", "note": "size along z", "group": null}, {"name": "screws_x", "default": "3", "note": "number of screws along x", "group": null}, {"name": "screws_y", "default": "2", "note": "number of screws along y", "group": null}, {"name": "edge_margin", "default": "5", "note": "plate edge to the nearest screw centre", "group": null}, {"name": "hole_type", "default": "2", "note": "0 none, 1 plain, 2 countersunk, 3 counterbored", "group": null}, {"name": "screw_diam", "default": "3", "note": "screw shank diameter", "group": null}, {"name": "head_diam", "default": "6", "note": "screw head diameter", "group": null}, {"name": "head_angle", "default": "90 deg", "note": "countersink included angle", "group": null}, {"name": "head_height", "default": "3", "note": "counterbore depth (screw head height)", "group": null}, {"name": "tolerance", "default": "0.1", "note": "clearance, normal to every face", "group": null}],
  "fixed": [],
  "derived": [{"name": "over", "expr": "0.5", "note": "overshoot past each plate face"}, {"name": "r_s", "expr": "screw_diam / 2 + tolerance", "note": "shank hole radius"}, {"name": "alpha", "expr": "90 deg - head_angle / 2", "note": "countersink flank to the face"}, {"name": "cs_r", "expr": "head_diam / 2 + tolerance / sin(alpha)", "note": "countersink radius at the top face"}, {"name": "cs_depth", "expr": "(cs_r - r_s) * tan(alpha)", "note": "countersink depth"}, {"name": "cb_r", "expr": "head_diam / 2 + tolerance", "note": "counterbore radius"}, {"name": "cb_depth", "expr": "head_height + tolerance", "note": "counterbore depth"}, {"name": "r_b", "expr": "hole_type == 2 ? cs_r : (hole_type == 3 ? cb_r : r_s)", "note": "radius at the top face"}, {"name": "z_a", "expr": "hole_type == 2 ? thickness - cs_depth : (hole_type == 3 ? thickness - cb_depth : thickness / 3)", "note": "top of the shank"}, {"name": "z_b", "expr": "hole_type == 2 ? thickness : (hole_type == 3 ? thickness - cb_depth : 2 * thickness / 3)", "note": "bottom of the full-width part"}, {"name": "pitch_x", "expr": "screws_x > 1 ? (length - 2 * edge_margin) / (screws_x - 1) : 0", "note": "screw spacing along x"}, {"name": "pitch_y", "expr": "screws_y > 1 ? (width - 2 * edge_margin) / (screws_y - 1) : 0", "note": "screw spacing along y"}, {"name": "x0", "expr": "screws_x > 1 ? edge_margin : length / 2", "note": "first screw centre, x"}, {"name": "y0", "expr": "screws_y > 1 ? edge_margin : width / 2", "note": "first screw centre, y"}, {"name": "drop", "expr": "hole_type == 0 ? -(3 * thickness + 10) : 0", "note": "moves the holes clear of the plate for hole_type 0"}],
  "checks": [{"expr": "hole_type < 0 ? 0 : (hole_type > 3 ? 0 : 1)", "message": "hole_type must be 0, 1, 2 or 3"}, {"expr": "thickness", "message": "thickness must be positive"}, {"expr": "screw_diam", "message": "screw_diam must be positive"}, {"expr": "head_diam - screw_diam", "message": "head_diam must exceed screw_diam"}, {"expr": "hole_type == 2 ? thickness - cs_depth : 1", "message": "the countersink is deeper than the plate"}, {"expr": "hole_type == 3 ? thickness - cb_depth : 1", "message": "the counterbore is deeper than the plate"}, {"expr": "screws_x", "message": "screws_x must be at least 1"}, {"expr": "screws_y", "message": "screws_y must be at least 1"}, {"expr": "length - 2 * edge_margin", "message": "length leaves no room inside the edge margins"}, {"expr": "width - 2 * edge_margin", "message": "width leaves no room inside the edge margins"}, {"expr": "hole_type == 0 ? 1 : edge_margin - r_b", "message": "edge_margin is too small: the holes break out of the plate edge"}, {"expr": "hole_type == 0 ? 1 : (screws_x > 1 ? pitch_x - 2 * r_b : 1)", "message": "screws_x is too many: the holes overlap"}, {"expr": "hole_type == 0 ? 1 : (screws_y > 1 ? pitch_y - 2 * r_b : 1)", "message": "screws_y is too many: the holes overlap"}],
  "result": 4,
  "motion": [],
  "ops": [
    {"id": 0, "op": "box", "name": "blank", "x": ["0", "length"], "y": ["0", "width"], "z": ["0", "thickness"]},
    {"id": 1, "op": "revolve", "name": "hole", "points": [["0", "-(0.5)"], ["(((screw_diam)) / 2 + ((tolerance)))", "-(0.5)"], ["(((screw_diam)) / 2 + ((tolerance)))", "(((hole_type)) == 2 ? ((thickness)) - (((((head_diam)) / 2 + ((tolerance)) / sin((90 deg - ((head_angle)) / 2))) - (((screw_diam)) / 2 + ((tolerance)))) * tan((90 deg - ((head_angle)) / 2))) : (((hole_type)) == 3 ? ((thickness)) - (((head_height)) + ((tolerance))) : ((thickness)) / 3))"], ["(((hole_type)) == 2 ? (((head_diam)) / 2 + ((tolerance)) / sin((90 deg - ((head_angle)) / 2))) : (((hole_type)) == 3 ? (((head_diam)) / 2 + ((tolerance))) : (((screw_diam)) / 2 + ((tolerance)))))", "(((hole_type)) == 2 ? ((thickness)) : (((hole_type)) == 3 ? ((thickness)) - (((head_height)) + ((tolerance))) : 2 * ((thickness)) / 3))"], ["(((hole_type)) == 2 ? (((head_diam)) / 2 + ((tolerance)) / sin((90 deg - ((head_angle)) / 2))) : (((hole_type)) == 3 ? (((head_diam)) / 2 + ((tolerance))) : (((screw_diam)) / 2 + ((tolerance)))))", "((thickness)) + (0.5)"], ["0", "((thickness)) + (0.5)"]], "span": ["0", "360"]},
    {"id": 2, "op": "array", "name": "holes", "base": 1, "along": {"x": {"count": "screws_x", "start": "x0", "step": "pitch_x"}, "y": {"count": "screws_y", "start": "y0", "step": "pitch_y"}}},
    {"id": 3, "op": "move", "name": null, "base": 2, "by": [null, null, "drop"]},
    {"id": 4, "op": "cut", "name": null, "base": 0, "tools": [3]}
  ]
}
