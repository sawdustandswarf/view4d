{
  "format": "primlib.prim",
  "version": 1,
  "primitive": "stencil",
  "title": "Stencil",
  "params": [{"name": "length", "default": "160", "note": "the template's overall size, x, fences included", "group": "Plate"}, {"name": "width", "default": "120", "note": "the template's overall size, y, fences included", "group": "Plate"}, {"name": "thickness", "default": "6", "note": "the plate's thickness, z: at least the guide bearing's height for a router", "group": "Plate"}, {"name": "bit_d", "default": "6.35", "note": "the router's guide bearing (or bit) diameter; 0 for a pencil or paint", "group": "Plate"}, {"name": "clearance", "default": "0.2", "note": "between the fences and the board's edges", "group": "Plate"}, {"name": "fence_top", "default": "0", "note": "1: a fence along the top edge (+y), hooking over the board's edge; 0: none", "group": "Fences"}, {"name": "fence_bottom", "default": "1", "note": "1: a fence along the bottom edge (-y); 0: none", "group": "Fences"}, {"name": "fence_left", "default": "1", "note": "1: a fence along the left edge (-x); 0: none", "group": "Fences"}, {"name": "fence_right", "default": "0", "note": "1: a fence along the right edge (+x); 0: none", "group": "Fences"}, {"name": "fence_t", "default": "3", "note": "each fence's thickness", "group": "Fences"}, {"name": "fence_depth", "default": "6", "note": "how far each fence reaches down the board's edge", "group": "Fences"}, {"name": "lines", "default": "2", "note": "lines of text in use: 1 to 6", "group": "Text"}, {"name": "text_size", "default": "40", "note": "capital height of the letters (each line's default)", "group": "Text"}, {"name": "font", "default": "'/usr/share/fonts/liberation/LiberationSans-Bold.ttf", "note": "the font file (each line's default); it must be installed where the file is opened", "group": "Text"}, {"name": "line_gap", "default": "12", "note": "between the lines, capital to capital, y (for the default line positions)", "group": "Text"}, {"name": "origin_x", "default": "0", "note": "the text's origin from the template's centre, x", "group": "Text"}, {"name": "origin_y", "default": "0", "note": "the text's origin from the template's centre, y", "group": "Text"}, {"name": "text1", "default": "'OAK", "note": "line 1's text", "group": "Line 1"}, {"name": "font1", "default": "=font", "note": "line 1's font file", "group": "Line 1"}, {"name": "size1", "default": "=text_size", "note": "line 1's capital height", "group": "Line 1"}, {"name": "line1_x", "default": "0", "note": "line 1's anchor from the origin, x", "group": "Line 1"}, {"name": "line1_y", "default": "=(lines - 1) / 2 * (text_size + line_gap) - 0 * (text_size + line_gap)", "note": "line 1's anchor from the origin, y (default: the lines stacked, centred on the origin)", "group": "Line 1"}, {"name": "h1", "default": "1", "note": "line 1's horizontal justification on its anchor: 0 left, 1 centre, 2 right", "group": "Line 1"}, {"name": "v1", "default": "1", "note": "line 1's vertical justification on its anchor: 0 top, 1 middle, 2 bottom (the baseline), of the capital height", "group": "Line 1"}, {"name": "text2", "default": "'48", "note": "line 2's text", "group": "Line 2"}, {"name": "font2", "default": "=font", "note": "line 2's font file", "group": "Line 2"}, {"name": "size2", "default": "=text_size", "note": "line 2's capital height", "group": "Line 2"}, {"name": "line2_x", "default": "0", "note": "line 2's anchor from the origin, x", "group": "Line 2"}, {"name": "line2_y", "default": "=(lines - 1) / 2 * (text_size + line_gap) - 1 * (text_size + line_gap)", "note": "line 2's anchor from the origin, y (default: the lines stacked, centred on the origin)", "group": "Line 2"}, {"name": "h2", "default": "1", "note": "line 2's horizontal justification on its anchor: 0 left, 1 centre, 2 right", "group": "Line 2"}, {"name": "v2", "default": "1", "note": "line 2's vertical justification on its anchor: 0 top, 1 middle, 2 bottom (the baseline), of the capital height", "group": "Line 2"}, {"name": "text3", "default": "'LINE 3", "note": "line 3's text", "group": "Line 3"}, {"name": "font3", "default": "=font", "note": "line 3's font file", "group": "Line 3"}, {"name": "size3", "default": "=text_size", "note": "line 3's capital height", "group": "Line 3"}, {"name": "line3_x", "default": "0", "note": "line 3's anchor from the origin, x", "group": "Line 3"}, {"name": "line3_y", "default": "=(lines - 1) / 2 * (text_size + line_gap) - 2 * (text_size + line_gap)", "note": "line 3's anchor from the origin, y (default: the lines stacked, centred on the origin)", "group": "Line 3"}, {"name": "h3", "default": "1", "note": "line 3's horizontal justification on its anchor: 0 left, 1 centre, 2 right", "group": "Line 3"}, {"name": "v3", "default": "1", "note": "line 3's vertical justification on its anchor: 0 top, 1 middle, 2 bottom (the baseline), of the capital height", "group": "Line 3"}, {"name": "text4", "default": "'LINE 4", "note": "line 4's text", "group": "Line 4"}, {"name": "font4", "default": "=font", "note": "line 4's font file", "group": "Line 4"}, {"name": "size4", "default": "=text_size", "note": "line 4's capital height", "group": "Line 4"}, {"name": "line4_x", "default": "0", "note": "line 4's anchor from the origin, x", "group": "Line 4"}, {"name": "line4_y", "default": "=(lines - 1) / 2 * (text_size + line_gap) - 3 * (text_size + line_gap)", "note": "line 4's anchor from the origin, y (default: the lines stacked, centred on the origin)", "group": "Line 4"}, {"name": "h4", "default": "1", "note": "line 4's horizontal justification on its anchor: 0 left, 1 centre, 2 right", "group": "Line 4"}, {"name": "v4", "default": "1", "note": "line 4's vertical justification on its anchor: 0 top, 1 middle, 2 bottom (the baseline), of the capital height", "group": "Line 4"}, {"name": "text5", "default": "'LINE 5", "note": "line 5's text", "group": "Line 5"}, {"name": "font5", "default": "=font", "note": "line 5's font file", "group": "Line 5"}, {"name": "size5", "default": "=text_size", "note": "line 5's capital height", "group": "Line 5"}, {"name": "line5_x", "default": "0", "note": "line 5's anchor from the origin, x", "group": "Line 5"}, {"name": "line5_y", "default": "=(lines - 1) / 2 * (text_size + line_gap) - 4 * (text_size + line_gap)", "note": "line 5's anchor from the origin, y (default: the lines stacked, centred on the origin)", "group": "Line 5"}, {"name": "h5", "default": "1", "note": "line 5's horizontal justification on its anchor: 0 left, 1 centre, 2 right", "group": "Line 5"}, {"name": "v5", "default": "1", "note": "line 5's vertical justification on its anchor: 0 top, 1 middle, 2 bottom (the baseline), of the capital height", "group": "Line 5"}, {"name": "text6", "default": "'LINE 6", "note": "line 6's text", "group": "Line 6"}, {"name": "font6", "default": "=font", "note": "line 6's font file", "group": "Line 6"}, {"name": "size6", "default": "=text_size", "note": "line 6's capital height", "group": "Line 6"}, {"name": "line6_x", "default": "0", "note": "line 6's anchor from the origin, x", "group": "Line 6"}, {"name": "line6_y", "default": "=(lines - 1) / 2 * (text_size + line_gap) - 5 * (text_size + line_gap)", "note": "line 6's anchor from the origin, y (default: the lines stacked, centred on the origin)", "group": "Line 6"}, {"name": "h6", "default": "1", "note": "line 6's horizontal justification on its anchor: 0 left, 1 centre, 2 right", "group": "Line 6"}, {"name": "v6", "default": "1", "note": "line 6's vertical justification on its anchor: 0 top, 1 middle, 2 bottom (the baseline), of the capital height", "group": "Line 6"}, {"name": "bridges", "default": "1", "note": "1: bridges hold the letters' centres; 0: none, for a stencil font", "group": "Detail"}, {"name": "bridge_w", "default": "1.5", "note": "each bridge's width, y", "group": "Detail"}, {"name": "bar_a1", "default": "0.19", "note": "template A's lower bridge, as a fraction of the capital height", "group": "Detail"}, {"name": "bar_a2", "default": "0.62", "note": "template A's upper bridge", "group": "Detail"}, {"name": "bar_b1", "default": "0.41", "note": "template B's lower bridge", "group": "Detail"}, {"name": "bar_b2", "default": "0.82", "note": "template B's upper bridge", "group": "Detail"}],
  "fixed": [],
  "derived": [{"name": "x_lo", "expr": "-length / 2 + (fence_left > 0.5 ? fence_t + clearance : 0)", "note": "the board's area under the template, left end: inside the left fence, if any"}, {"name": "x_hi", "expr": "length / 2 - (fence_right > 0.5 ? fence_t + clearance : 0)", "note": "and its right end"}, {"name": "y_lo", "expr": "-width / 2 + (fence_bottom > 0.5 ? fence_t + clearance : 0)", "note": "and its bottom edge"}, {"name": "y_hi", "expr": "width / 2 - (fence_top > 0.5 ? fence_t + clearance : 0)", "note": "and its top edge"}, {"name": "sep", "expr": "min(abs(bar_a1 - bar_b1); abs(bar_a1 - bar_b2); abs(bar_a2 - bar_b1); abs(bar_a2 - bar_b2)) * min(size1; size2; size3; size4; size5; size6)", "note": "the closest bridges of A and B, centre to centre, on the smallest line"}, {"name": "ax1", "expr": "origin_x + line1_x", "note": "line 1's anchor, x"}, {"name": "ay1", "expr": "origin_y + line1_y", "note": "line 1's anchor, y"}, {"name": "az1", "expr": "lines > 1 - 0.5 ? -1 : -1000", "note": "line 1's text, z: just under the plate, or well below it when not in use"}, {"name": "zb1", "expr": "bridges > 0.5 ? (lines > 1 - 0.5 ? -1 : -1000) : -1000", "note": "line 1's bridges: in the plate, or below it (no bridges, or the line not in use)"}, {"name": "lo1", "expr": "ay1 - (v1 < 0.5 ? size1 : (v1 < 1.5 ? size1 / 2 : 0))", "note": "line 1's baseline (the bottom of its capitals), y"}, {"name": "ax2", "expr": "origin_x + line2_x", "note": "line 2's anchor, x"}, {"name": "ay2", "expr": "origin_y + line2_y", "note": "line 2's anchor, y"}, {"name": "az2", "expr": "lines > 2 - 0.5 ? -1 : -1000", "note": "line 2's text, z: just under the plate, or well below it when not in use"}, {"name": "zb2", "expr": "bridges > 0.5 ? (lines > 2 - 0.5 ? -1 : -1000) : -1000", "note": "line 2's bridges: in the plate, or below it (no bridges, or the line not in use)"}, {"name": "lo2", "expr": "ay2 - (v2 < 0.5 ? size2 : (v2 < 1.5 ? size2 / 2 : 0))", "note": "line 2's baseline (the bottom of its capitals), y"}, {"name": "ax3", "expr": "origin_x + line3_x", "note": "line 3's anchor, x"}, {"name": "ay3", "expr": "origin_y + line3_y", "note": "line 3's anchor, y"}, {"name": "az3", "expr": "lines > 3 - 0.5 ? -1 : -1000", "note": "line 3's text, z: just under the plate, or well below it when not in use"}, {"name": "zb3", "expr": "bridges > 0.5 ? (lines > 3 - 0.5 ? -1 : -1000) : -1000", "note": "line 3's bridges: in the plate, or below it (no bridges, or the line not in use)"}, {"name": "lo3", "expr": "ay3 - (v3 < 0.5 ? size3 : (v3 < 1.5 ? size3 / 2 : 0))", "note": "line 3's baseline (the bottom of its capitals), y"}, {"name": "ax4", "expr": "origin_x + line4_x", "note": "line 4's anchor, x"}, {"name": "ay4", "expr": "origin_y + line4_y", "note": "line 4's anchor, y"}, {"name": "az4", "expr": "lines > 4 - 0.5 ? -1 : -1000", "note": "line 4's text, z: just under the plate, or well below it when not in use"}, {"name": "zb4", "expr": "bridges > 0.5 ? (lines > 4 - 0.5 ? -1 : -1000) : -1000", "note": "line 4's bridges: in the plate, or below it (no bridges, or the line not in use)"}, {"name": "lo4", "expr": "ay4 - (v4 < 0.5 ? size4 : (v4 < 1.5 ? size4 / 2 : 0))", "note": "line 4's baseline (the bottom of its capitals), y"}, {"name": "ax5", "expr": "origin_x + line5_x", "note": "line 5's anchor, x"}, {"name": "ay5", "expr": "origin_y + line5_y", "note": "line 5's anchor, y"}, {"name": "az5", "expr": "lines > 5 - 0.5 ? -1 : -1000", "note": "line 5's text, z: just under the plate, or well below it when not in use"}, {"name": "zb5", "expr": "bridges > 0.5 ? (lines > 5 - 0.5 ? -1 : -1000) : -1000", "note": "line 5's bridges: in the plate, or below it (no bridges, or the line not in use)"}, {"name": "lo5", "expr": "ay5 - (v5 < 0.5 ? size5 : (v5 < 1.5 ? size5 / 2 : 0))", "note": "line 5's baseline (the bottom of its capitals), y"}, {"name": "ax6", "expr": "origin_x + line6_x", "note": "line 6's anchor, x"}, {"name": "ay6", "expr": "origin_y + line6_y", "note": "line 6's anchor, y"}, {"name": "az6", "expr": "lines > 6 - 0.5 ? -1 : -1000", "note": "line 6's text, z: just under the plate, or well below it when not in use"}, {"name": "zb6", "expr": "bridges > 0.5 ? (lines > 6 - 0.5 ? -1 : -1000) : -1000", "note": "line 6's bridges: in the plate, or below it (no bridges, or the line not in use)"}, {"name": "lo6", "expr": "ay6 - (v6 < 0.5 ? size6 : (v6 < 1.5 ? size6 / 2 : 0))", "note": "line 6's baseline (the bottom of its capitals), y"}],
  "checks": [{"expr": "(lines - 0.5) * (6 + 0.5 - lines)", "message": "lines must be 1 to 6"}, {"expr": "sep - bridge_w - bit_d + 0.000001", "message": "A's and B's bridges are closer than bridge_w + bit_d: B can't rout what A's bridges hide"}, {"expr": "bridge_w", "message": "bridge_w must be positive"}, {"expr": "min(bar_a1; bar_a2; bar_b1; bar_b2) * (1 - max(bar_a1; bar_a2; bar_b1; bar_b2))", "message": "each bridge must lie within the capital height (between 0 and 1)"}, {"expr": "thickness", "message": "thickness must be positive"}, {"expr": "fence_t", "message": "fence_t must be positive"}, {"expr": "fence_depth", "message": "fence_depth must be positive"}, {"expr": "x_hi - x_lo - 2 * bit_d - 2", "message": "the fences leave too little of the board's area"}, {"expr": "y_hi - y_lo - 2 * bit_d - 2", "message": "the fences leave too little of the board's area"}, {"expr": "lines < 1 - 0.5 ? 1 : (lo1 - y_lo - bit_d / 2 - 1)", "message": "line 1 runs off the board's area at the bottom (y)"}, {"expr": "lines < 1 - 0.5 ? 1 : (y_hi - lo1 - size1 - bit_d / 2 - 1)", "message": "line 1 runs off the board's area at the top (y)"}, {"expr": "lines < 1 - 0.5 ? 1 : size1", "message": "line 1's size must be positive"}, {"expr": "(h1 + 0.5) * (2.5 - h1)", "message": "h1 must be 0, 1 or 2"}, {"expr": "(v1 + 0.5) * (2.5 - v1)", "message": "v1 must be 0, 1 or 2"}, {"expr": "lines < 2 - 0.5 ? 1 : (lo2 - y_lo - bit_d / 2 - 1)", "message": "line 2 runs off the board's area at the bottom (y)"}, {"expr": "lines < 2 - 0.5 ? 1 : (y_hi - lo2 - size2 - bit_d / 2 - 1)", "message": "line 2 runs off the board's area at the top (y)"}, {"expr": "lines < 2 - 0.5 ? 1 : size2", "message": "line 2's size must be positive"}, {"expr": "(h2 + 0.5) * (2.5 - h2)", "message": "h2 must be 0, 1 or 2"}, {"expr": "(v2 + 0.5) * (2.5 - v2)", "message": "v2 must be 0, 1 or 2"}, {"expr": "lines < 3 - 0.5 ? 1 : (lo3 - y_lo - bit_d / 2 - 1)", "message": "line 3 runs off the board's area at the bottom (y)"}, {"expr": "lines < 3 - 0.5 ? 1 : (y_hi - lo3 - size3 - bit_d / 2 - 1)", "message": "line 3 runs off the board's area at the top (y)"}, {"expr": "lines < 3 - 0.5 ? 1 : size3", "message": "line 3's size must be positive"}, {"expr": "(h3 + 0.5) * (2.5 - h3)", "message": "h3 must be 0, 1 or 2"}, {"expr": "(v3 + 0.5) * (2.5 - v3)", "message": "v3 must be 0, 1 or 2"}, {"expr": "lines < 4 - 0.5 ? 1 : (lo4 - y_lo - bit_d / 2 - 1)", "message": "line 4 runs off the board's area at the bottom (y)"}, {"expr": "lines < 4 - 0.5 ? 1 : (y_hi - lo4 - size4 - bit_d / 2 - 1)", "message": "line 4 runs off the board's area at the top (y)"}, {"expr": "lines < 4 - 0.5 ? 1 : size4", "message": "line 4's size must be positive"}, {"expr": "(h4 + 0.5) * (2.5 - h4)", "message": "h4 must be 0, 1 or 2"}, {"expr": "(v4 + 0.5) * (2.5 - v4)", "message": "v4 must be 0, 1 or 2"}, {"expr": "lines < 5 - 0.5 ? 1 : (lo5 - y_lo - bit_d / 2 - 1)", "message": "line 5 runs off the board's area at the bottom (y)"}, {"expr": "lines < 5 - 0.5 ? 1 : (y_hi - lo5 - size5 - bit_d / 2 - 1)", "message": "line 5 runs off the board's area at the top (y)"}, {"expr": "lines < 5 - 0.5 ? 1 : size5", "message": "line 5's size must be positive"}, {"expr": "(h5 + 0.5) * (2.5 - h5)", "message": "h5 must be 0, 1 or 2"}, {"expr": "(v5 + 0.5) * (2.5 - v5)", "message": "v5 must be 0, 1 or 2"}, {"expr": "lines < 6 - 0.5 ? 1 : (lo6 - y_lo - bit_d / 2 - 1)", "message": "line 6 runs off the board's area at the bottom (y)"}, {"expr": "lines < 6 - 0.5 ? 1 : (y_hi - lo6 - size6 - bit_d / 2 - 1)", "message": "line 6 runs off the board's area at the top (y)"}, {"expr": "lines < 6 - 0.5 ? 1 : size6", "message": "line 6's size must be positive"}, {"expr": "(h6 + 0.5) * (2.5 - h6)", "message": "h6 must be 0, 1 or 2"}, {"expr": "(v6 + 0.5) * (2.5 - v6)", "message": "v6 must be 0, 1 or 2"}],
  "result": 47,
  "motion": [],
  "ops": [
    {"id": 0, "op": "box", "name": "plate", "x": ["-length / 2", "length / 2"], "y": ["-width / 2", "width / 2"], "z": ["0", "thickness"]},
    {"id": 1, "op": "box", "name": "fence_top", "x": ["-length / 2", "length / 2"], "y": ["width / 2 - fence_t", "width / 2"], "z": ["fence_top > 0.5 ? -fence_depth : 0.001", "0.01"]},
    {"id": 2, "op": "box", "name": "fence_bottom", "x": ["-length / 2", "length / 2"], "y": ["-width / 2", "-width / 2 + fence_t"], "z": ["fence_bottom > 0.5 ? -fence_depth : 0.001", "0.01"]},
    {"id": 3, "op": "box", "name": "fence_left", "x": ["-length / 2", "-length / 2 + fence_t"], "y": ["-width / 2", "width / 2"], "z": ["fence_left > 0.5 ? -fence_depth : 0.001", "0.01"]},
    {"id": 4, "op": "box", "name": "fence_right", "x": ["length / 2 - fence_t", "length / 2"], "y": ["-width / 2", "width / 2"], "z": ["fence_right > 0.5 ? -fence_depth : 0.001", "0.01"]},
    {"id": 5, "op": "fuse", "name": "body", "of": [0, 1, 2, 3, 4]},
    {"id": 6, "op": "text", "name": "line1_string", "string": "text1", "font": "font1", "size": "size1", "at": ["ax1", "ay1", "az1"], "justify": "v1 * 3 + h1"},
    {"id": 7, "op": "text", "name": "line2_string", "string": "text2", "font": "font2", "size": "size2", "at": ["ax2", "ay2", "az2"], "justify": "v2 * 3 + h2"},
    {"id": 8, "op": "text", "name": "line3_string", "string": "text3", "font": "font3", "size": "size3", "at": ["ax3", "ay3", "az3"], "justify": "v3 * 3 + h3"},
    {"id": 9, "op": "text", "name": "line4_string", "string": "text4", "font": "font4", "size": "size4", "at": ["ax4", "ay4", "az4"], "justify": "v4 * 3 + h4"},
    {"id": 10, "op": "text", "name": "line5_string", "string": "text5", "font": "font5", "size": "size5", "at": ["ax5", "ay5", "az5"], "justify": "v5 * 3 + h5"},
    {"id": 11, "op": "text", "name": "line6_string", "string": "text6", "font": "font6", "size": "size6", "at": ["ax6", "ay6", "az6"], "justify": "v6 * 3 + h6"},
    {"id": 12, "op": "extrude", "name": "line1", "base": 6, "length": "thickness + 2", "z": null},
    {"id": 13, "op": "extrude", "name": "line2", "base": 7, "length": "thickness + 2", "z": null},
    {"id": 14, "op": "extrude", "name": "line3", "base": 8, "length": "thickness + 2", "z": null},
    {"id": 15, "op": "extrude", "name": "line4", "base": 9, "length": "thickness + 2", "z": null},
    {"id": 16, "op": "extrude", "name": "line5", "base": 10, "length": "thickness + 2", "z": null},
    {"id": 17, "op": "extrude", "name": "line6", "base": 11, "length": "thickness + 2", "z": null},
    {"id": 18, "op": "fuse", "name": "letters", "of": [12, 13, 14, 15, 16, 17]},
    {"id": 19, "op": "box", "name": "a_bar11", "x": ["xmin(@6) - 0.2", "xmax(@6) + 0.2"], "y": ["lo1 + bar_a1 * size1 - bridge_w / 2", "lo1 + bar_a1 * size1 + bridge_w / 2"], "z": ["zb1", "zb1 + thickness + 2"]},
    {"id": 20, "op": "box", "name": "a_bar12", "x": ["xmin(@6) - 0.2", "xmax(@6) + 0.2"], "y": ["lo1 + bar_a2 * size1 - bridge_w / 2", "lo1 + bar_a2 * size1 + bridge_w / 2"], "z": ["zb1", "zb1 + thickness + 2"]},
    {"id": 21, "op": "box", "name": "a_bar21", "x": ["xmin(@7) - 0.2", "xmax(@7) + 0.2"], "y": ["lo2 + bar_a1 * size2 - bridge_w / 2", "lo2 + bar_a1 * size2 + bridge_w / 2"], "z": ["zb2", "zb2 + thickness + 2"]},
    {"id": 22, "op": "box", "name": "a_bar22", "x": ["xmin(@7) - 0.2", "xmax(@7) + 0.2"], "y": ["lo2 + bar_a2 * size2 - bridge_w / 2", "lo2 + bar_a2 * size2 + bridge_w / 2"], "z": ["zb2", "zb2 + thickness + 2"]},
    {"id": 23, "op": "box", "name": "a_bar31", "x": ["xmin(@8) - 0.2", "xmax(@8) + 0.2"], "y": ["lo3 + bar_a1 * size3 - bridge_w / 2", "lo3 + bar_a1 * size3 + bridge_w / 2"], "z": ["zb3", "zb3 + thickness + 2"]},
    {"id": 24, "op": "box", "name": "a_bar32", "x": ["xmin(@8) - 0.2", "xmax(@8) + 0.2"], "y": ["lo3 + bar_a2 * size3 - bridge_w / 2", "lo3 + bar_a2 * size3 + bridge_w / 2"], "z": ["zb3", "zb3 + thickness + 2"]},
    {"id": 25, "op": "box", "name": "a_bar41", "x": ["xmin(@9) - 0.2", "xmax(@9) + 0.2"], "y": ["lo4 + bar_a1 * size4 - bridge_w / 2", "lo4 + bar_a1 * size4 + bridge_w / 2"], "z": ["zb4", "zb4 + thickness + 2"]},
    {"id": 26, "op": "box", "name": "a_bar42", "x": ["xmin(@9) - 0.2", "xmax(@9) + 0.2"], "y": ["lo4 + bar_a2 * size4 - bridge_w / 2", "lo4 + bar_a2 * size4 + bridge_w / 2"], "z": ["zb4", "zb4 + thickness + 2"]},
