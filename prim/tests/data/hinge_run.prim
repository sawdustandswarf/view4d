{
  "format": "primlib.prim",
  "version": 2,
  "kind": "recipe",
  "primitive": "hinge_run",
  "title": "Hinge run",
  "params": [{"name": "run", "default": "300", "note": "the length of the row", "group": "Run"}, {"name": "key", "default": "'TFT", "note": "the hinges in order: S, M, L fixed, T the little one, F fit", "group": "Run"}, {"name": "fallback", "default": "'TFT", "note": "the key used when `key`'s fit hinge is under min_fit", "group": "Run"}, {"name": "small", "default": "20", "note": "an S hinge's length", "group": "Run"}, {"name": "medium", "default": "35", "note": "an M hinge's length", "group": "Run"}, {"name": "large", "default": "50", "note": "an L hinge's length", "group": "Run"}, {"name": "little", "default": "13", "note": "the T hinge's length", "group": "Run"}, {"name": "gap", "default": "0.2", "note": "between hinges, and at each end", "group": "Run"}, {"name": "min_fit", "default": "10", "note": "the shortest fit hinge", "group": "Run"}, {"name": "pitch", "default": "10", "note": "the ring pitch", "group": "Hinges"}, {"name": "pitch_little", "default": "6.5", "note": "the T hinge's ring pitch", "group": "Hinges"}, {"name": "side", "default": "18", "note": "each leaf beyond its tab", "group": "Hinges"}, {"name": "side_a_little", "default": "18", "note": "the T hinge's side A leaf beyond its tab", "group": "Hinges"}, {"name": "side_b_little", "default": "18", "note": "the T hinge's side B leaf beyond its tab", "group": "Hinges"}, {"name": "open_angle", "default": "0", "note": "side A's leaves turned about the axis, degrees: up is +", "group": "Hinges"}],
  "fixed": [],
  "derived": [{"name": "raw_fit", "expr": "count(key; <<F>>) > 0 ? (run - (len(key) + 1) * gap - count(key; <<S>>) * small - count(key; <<M>>) * medium - count(key; <<L>>) * large - count(key; <<T>>) * little) / count(key; <<F>>) : 0", "note": "the fit length with the key as typed"}, {"name": "use", "expr": "raw_fit < min_fit ? fallback : key", "note": "the key in use: as typed, or the fallback"}, {"name": "fit_length", "expr": "count(use; <<F>>) > 0 ? (run - (len(use) + 1) * gap - count(use; <<S>>) * small - count(use; <<M>>) * medium - count(use; <<L>>) * large - count(use; <<T>>) * little) / count(use; <<F>>) : 0", "note": "each fit hinge's length"}, {"name": "fit_hinge", "expr": "max(fit_length; 7)", "note": "the fit hinge built: at least 7"}],
  "checks": [{"expr": "len(key) <= 7", "message": "key is longer than 7 letters"}, {"expr": "len(fallback) <= 7", "message": "fallback is longer than 7 letters"}, {"expr": "count(key; <<S>>) + count(key; <<M>>) + count(key; <<L>>) + count(key; <<F>>) + count(key; <<T>>) == len(key)", "message": "key has a letter other than S M L F T"}, {"expr": "count(fallback; <<S>>) + count(fallback; <<M>>) + count(fallback; <<L>>) + count(fallback; <<F>>) + count(fallback; <<T>>) == len(fallback)", "message": "fallback has a letter other than S M L F T"}, {"expr": "count(fallback; <<F>>)", "message": "fallback needs an F"}, {"expr": "fit_length >= min_fit", "message": "the run is too short, even with the fallback key"}],
  "slots": 7,
  "result": 3,
  "motion": [],
  "parts": [
    {"name": "S", "primitive": "hinge", "bind": {"length": "small", "rings": "max(2; floor(small / pitch + 0.5))", "side_a": "side", "side_b": "side"}, "mirror": null, "colour": null, "pieces": ["side_b", "pins"], "print": false},
    {"name": "S_lid", "primitive": "hinge", "bind": {"length": "small", "rings": "max(2; floor(small / pitch + 0.5))", "side_a": "side", "side_b": "side"}, "mirror": null, "colour": null, "pieces": ["side_a"], "print": false},
    {"name": "M", "primitive": "hinge", "bind": {"length": "medium", "rings": "max(2; floor(medium / pitch + 0.5))", "side_a": "side", "side_b": "side"}, "mirror": null, "colour": null, "pieces": ["side_b", "pins"], "print": false},
    {"name": "M_lid", "primitive": "hinge", "bind": {"length": "medium", "rings": "max(2; floor(medium / pitch + 0.5))", "side_a": "side", "side_b": "side"}, "mirror": null, "colour": null, "pieces": ["side_a"], "print": false},
    {"name": "L", "primitive": "hinge", "bind": {"length": "large", "rings": "max(2; floor(large / pitch + 0.5))", "side_a": "side", "side_b": "side"}, "mirror": null, "colour": null, "pieces": ["side_b", "pins"], "print": false},
    {"name": "L_lid", "primitive": "hinge", "bind": {"length": "large", "rings": "max(2; floor(large / pitch + 0.5))", "side_a": "side", "side_b": "side"}, "mirror": null, "colour": null, "pieces": ["side_a"], "print": false},
    {"name": "F", "primitive": "hinge", "bind": {"length": "fit_hinge", "rings": "max(2; floor(fit_hinge / pitch + 0.5))", "side_a": "side", "side_b": "side"}, "mirror": null, "colour": null, "pieces": ["side_b", "pins"], "print": false},
    {"name": "F_lid", "primitive": "hinge", "bind": {"length": "fit_hinge", "rings": "max(2; floor(fit_hinge / pitch + 0.5))", "side_a": "side", "side_b": "side"}, "mirror": null, "colour": null, "pieces": ["side_a"], "print": false},
    {"name": "T", "primitive": "hinge", "bind": {"length": "little", "rings": "max(2; floor(little / pitch_little + 0.5))", "side_a": "side_a_little", "side_b": "side_b_little"}, "mirror": null, "colour": null, "pieces": ["side_b", "pins"], "print": false},
    {"name": "T_lid", "primitive": "hinge", "bind": {"length": "little", "rings": "max(2; floor(little / pitch_little + 0.5))", "side_a": "side_a_little", "side_b": "side_b_little"}, "mirror": null, "colour": null, "pieces": ["side_a"], "print": false}
  ],
  "place": [
    {"id": 0, "op": "row", "name": "hinge", "key": "use", "pieces": {"S": {"part": "S", "length": "small"}, "M": {"part": "M", "length": "medium"}, "L": {"part": "L", "length": "large"}, "F": {"part": "F", "length": "fit_length"}, "T": {"part": "T", "length": "little"}}, "at": ["0", "0", "0"], "along": "x", "gap": "gap", "lead": "gap", "turn": [{"axis": "x", "angle": "180"}, {"axis": "y", "angle": "-90"}]},
    {"id": 1, "op": "row", "name": "lidhinge", "key": "use", "pieces": {"S": {"part": "S_lid", "length": "small"}, "M": {"part": "M_lid", "length": "medium"}, "L": {"part": "L_lid", "length": "large"}, "F": {"part": "F_lid", "length": "fit_length"}, "T": {"part": "T_lid", "length": "little"}}, "at": ["0", "0", "0"], "along": "x", "gap": "gap", "lead": "gap", "turn": [{"axis": "x", "angle": "180"}, {"axis": "y", "angle": "-90"}]},
    {"id": 2, "op": "joint", "name": "open", "base": 1, "at": ["0", "0", "0"], "axis": "x", "angle": "open_angle"},
