    "box_edge": {
      "format": "primlib.prim",
      "version": 1,
      "primitive": "box_edge",
      "title": "Box edge",
      "params": [{"name": "length", "default": "100", "note": "along the edge", "group": "Length"}, {"name": "panel_t", "default": "6.5", "note": "the panels' thickness", "group": "Section"}, {"name": "skin", "default": "5", "note": "the wall over the panels' outsides", "group": "Section"}, {"name": "panel_gap", "default": "3", "note": "the web's width: how far the panels stop short of the inside corner", "group": "Section"}, {"name": "size", "default": "27", "note": "across the section, each way, from the outside face", "group": "Section"}, {"name": "bevel", "default": "15", "note": "the width of the big 45 degree bevel across the outside corner", "group": "Section"}, {"name": "chamfer", "default": "0.5", "note": "the small 45 degree chamfer on the outward square edges", "group": "Section"}, {"name": "glue", "default": "0", "note": "the glue line's thickness: how deep the pockets are behind the ridges; 0 for none", "group": "Section"}, {"name": "glue_ridge", "default": "0.6", "note": "the width of the ridges that hold a panel off the pockets' floor", "group": "Section"}, {"name": "relief", "default": "0", "note": "the -x wall's outside face cut back by this, across the whole section, its small chamfers carried round; 0 for none", "group": "Section"}, {"name": "drill_inset", "default": "6", "note": "the screw rows' first and last holes from the ends, and the rows' line from the panel's edge", "group": "Screws"}, {"name": "nominal_spacing", "default": "30", "note": "the longest pitch along a row", "group": "Screws"}, {"name": "min_spacing", "default": "7", "note": "under this between the end holes, a single middle hole", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "screw hole radius", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "countersink radius at the outside face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "countersink depth", "group": "Screws"}, {"name": "screw_len", "default": "20", "note": "the hole tool's length from the outside face", "group": "Screws"}, {"name": "holes_x", "default": "1", "note": "1 for the row through the -x wall, 0 for none", "group": "Screws"}, {"name": "holes_y", "default": "1", "note": "1 for the row through the -y wall, 0 for none", "group": "Screws"}],
      "fixed": [],
