            {"id": 1, "op": "prism", "name": "glue_skin_a", "points": [["(panel_gap + glue_ridge)", "((-panel_t) + (glue > 0 ? 0 : 1000))"], ["(reach - chamfer - glue_ridge)", "((-panel_t) + (glue > 0 ? 0 : 1000))"], ["(reach - chamfer - glue_ridge) - (glue > 0 ? glue : 0.01)", "((-panel_t) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)"], ["(panel_gap + glue_ridge) + (glue > 0 ? glue : 0.01)", "((-panel_t) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)"]], "plane": "xy", "span": ["-1", "length + 1"]},
            {"id": 2, "op": "prism", "name": "glue_skin_b", "points": [["((-panel_t) + (glue > 0 ? 0 : 1000))", "(panel_gap + glue_ridge)"], ["((-panel_t) + (glue > 0 ? 0 : 1000))", "(reach - chamfer - glue_ridge)"], ["((-panel_t) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)", "(reach - chamfer - glue_ridge) - (glue > 0 ? glue : 0.01)"], ["((-panel_t) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)", "(panel_gap + glue_ridge) + (glue > 0 ? glue : 0.01)"]], "plane": "xy", "span": ["-1", "length + 1"]},
            {"id": 3, "op": "prism", "name": "glue_web_a", "points": [["((panel_gap) + (glue > 0 ? 0 : 1000))", "(-panel_t + glue_ridge)"], ["((panel_gap) + (glue > 0 ? 0 : 1000))", "(-chamfer - glue_ridge)"], ["((panel_gap) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)", "(-chamfer - glue_ridge) - (glue > 0 ? glue : 0.01)"], ["((panel_gap) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)", "(-panel_t + glue_ridge) + (glue > 0 ? glue : 0.01)"]], "plane": "xy", "span": ["-1", "length + 1"]},
            {"id": 4, "op": "prism", "name": "glue_web_b", "points": [["(-panel_t + glue_ridge)", "((panel_gap) + (glue > 0 ? 0 : 1000))"], ["(-chamfer - glue_ridge)", "((panel_gap) + (glue > 0 ? 0 : 1000))"], ["(-chamfer - glue_ridge) - (glue > 0 ? glue : 0.01)", "((panel_gap) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)"], ["(-panel_t + glue_ridge) + (glue > 0 ? glue : 0.01)", "((panel_gap) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)"]], "plane": "xy", "span": ["-1", "length + 1"]},
            {"id": 5, "op": "cylinder", "name": "hole_y_shank", "axis": "y", "centre": ["inset + (holes_y > 0 ? 0 : 1000)", "0"], "r": "screw_r", "span": ["-(panel_t + skin)", "-(panel_t + skin) + screw_len"]},
            {"id": 6, "op": "cone", "name": "hole_y_head", "axis": "y", "centre": ["inset + (holes_y > 0 ? 0 : 1000)", "0"], "r1": "head_r", "r2": "screw_r", "span": ["-(panel_t + skin)", "-(panel_t + skin) + head_h"]},
            {"id": 7, "op": "fuse", "name": "hole_y", "of": [5, 6]},
            {"id": 8, "op": "cylinder", "name": "hole_x_shank", "axis": "x", "centre": ["inset + (holes_x > 0 ? 0 : 1000)", "0"], "r": "screw_r", "span": ["-(panel_t + skin)", "-(panel_t + skin) + screw_len"]},
            {"id": 9, "op": "cone", "name": "hole_x_head", "axis": "x", "centre": ["inset + (holes_x > 0 ? 0 : 1000)", "0"], "r1": "head_r", "r2": "screw_r", "span": ["-(panel_t + skin)", "-(panel_t + skin) + head_h"]},
            {"id": 10, "op": "fuse", "name": "hole_x", "of": [8, 9]},
            {"id": 11, "op": "fuse", "name": "hole", "of": [7, 10]},
            {"id": 12, "op": "array", "name": "holes", "base": 11, "along": {"z": {"count": "holes", "start": "holes > 1 ? drill_inset : length / 2", "step": "holes > 1 ? span / (holes - 1) : 0"}}},
            {"id": 13, "op": "beyond", "name": "relief_face", "normal": [-1.0, 0.0, 0.0], "d": "((panel_t + skin) - relief + (relief > 0 ? 0 : 1000))", "size": "(2 * length + 2 * size + 100)"},
            {"id": 14, "op": "beyond", "name": "relief_start", "normal": [-0.7071067811865475, 0.0, -0.7071067811865475], "d": "((((panel_t + skin) - relief + (relief > 0 ? 0 : 1000))) - chamfer) * 0.7071067812", "size": "(2 * length + 2 * size + 100)"},
            {"id": 15, "op": "beyond", "name": "relief_end", "normal": [-0.7071067811865475, 0.0, 0.7071067811865475], "d": "((((panel_t + skin) - relief + (relief > 0 ? 0 : 1000))) - chamfer + length) * 0.7071067812", "size": "(2 * length + 2 * size + 100)"},
            {"id": 16, "op": "beyond", "name": "relief_wall_end", "normal": [-0.7071067811865475, 0.7071067811865475, 0.0], "d": "((((panel_t + skin) - relief + (relief > 0 ? 0 : 1000))) - chamfer + reach) * 0.7071067812", "size": "(2 * length + 2 * size + 100)"},
            {"id": 17, "op": "cut", "name": null, "base": 0, "tools": [12, 1, 2, 3, 4, 13, 14, 15, 16]}
          ]
        }
      }
    },
    "rail_end": {
      "format": "primlib.prim",
      "version": 1,
      "primitive": "rail_end",
      "title": "Rail end",
      "params": [{"name": "size", "default": "27", "note": "the edge's section, each way, from the outside face", "group": "Edge"}, {"name": "panel_t", "default": "6.5", "note": "the panels' thickness", "group": "Edge"}, {"name": "skin", "default": "5", "note": "the wall over the panels' outsides", "group": "Edge"}, {"name": "panel_gap", "default": "3", "note": "the web's width", "group": "Edge"}, {"name": "bevel", "default": "15", "note": "the 45 degree bevel across each outside edge", "group": "Edge"}, {"name": "chamfer", "default": "0.5", "note": "on the outward square edges", "group": "Edge"}, {"name": "glue", "default": "0", "note": "the glue line's pockets behind the ridges; 0 for none", "group": "Edge"}, {"name": "glue_ridge", "default": "0.6", "note": "the ridges the panels sit on", "group": "Edge"}, {"name": "notch", "default": "3.85", "note": "the edge's underside cut back by this over the rail's width, to clear the rack (box_edge's relief)", "group": "Edge"}, {"name": "corner_size", "default": "40", "note": "the case's corner across each wall: the end piece is at least this long", "group": "Edge"}, {"name": "drill_inset", "default": "6", "note": "the edge's screw row from the inside corner, past the web", "group": "Screws"}, {"name": "nominal_spacing", "default": "30", "note": "the longest pitch along a row", "group": "Screws"}, {"name": "min_spacing", "default": "7", "note": "under this between the end holes, a single middle hole", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "the screw hole", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "the countersink at the outside face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "the countersink's depth", "group": "Screws"}, {"name": "screw_len", "default": "20", "note": "the edge's holes' length from the outside face", "group": "Screws"}, {"name": "screws", "default": "1", "note": "1 for the tongue's two rows of screws up into the bottom panel; 0 none", "group": "Screws"}, {"name": "base_depth", "default": "2", "note": "the rail's support, against the bottom panel", "group": "Rail"}, {"name": "printer_width_offset", "default": "0.2", "note": "topeak_rail's: added to its width in the model", "group": "Rail"}, {"name": "drop_on", "default": "15", "note": "after the bevel: the tongue cut back to a straight key that drops into the rack", "group": "Rail"}, {"name": "taper", "default": "10", "note": "after the drop-on: the tongue widens back to full size", "group": "Rail"}, {"name": "drop_clear", "default": "0.5", "note": "the key inside the tongue's neck, each side", "group": "Rail"}, {"name": "drop_chamfer", "default": "1", "note": "45 degrees on the key's tip edges", "group": "Rail"}],
      "fixed": [{"name": "width", "expr": "61.4", "note": "the outside width, between vertical tangents to the tip radii, what calipers read on the print"}, {"name": "angle", "expr": "60", "note": "the slope of the sides, flank to the tip face, deg"}, {"name": "depth", "expr": "6.35", "note": "the depth of the tongue, root to tip (1/4\", set by the rack)"}, {"name": "tip_radius", "expr": "0.7", "note": "the radius of the two tip corners"}, {"name": "root_radius", "expr": "1", "note": "the radius of the two root corners"}, {"name": "groove_width", "expr": "19.95", "note": "the width of the centre groove at the tip face"}, {"name": "groove_depth", "expr": "1.2", "note": "the depth of the centre groove, up from the tip face"}, {"name": "groove_angle", "expr": "45", "note": "the slope of the groove's sides to the tip face, deg"}],
      "derived": [{"name": "t_tip", "expr": "tip_radius / tan(angle / 2)", "note": "tip radius's tangent length"}, {"name": "t_root", "expr": "root_radius / tan(angle / 2)", "note": "root radius's tangent length, into a base wider than the root"}, {"name": "tip_hw", "expr": "width / 2 + t_tip - tip_radius", "note": "tip half-width, sharp"}, {"name": "root_hw", "expr": "tip_hw - depth / tan(angle)", "note": "root half-width, sharp"}, {"name": "width_check", "expr": "2 * (tip_hw - t_tip + tip_radius)", "note": "the width, worked back from the sharp corners"}, {"name": "key_hw", "expr": "root_hw + t_root - root_radius", "note": "the drop-on key's half-width, at the neck"}, {"name": "widest", "expr": "tip_hw + printer_width_offset / 2", "note": "the tongue's sharp corner, as modelled"}, {"name": "rail_w", "expr": "width + printer_width_offset", "note": "the rail's modelled width: the edge piece's length"}, {"name": "screw_y", "expr": "(groove_width / 2 + key_hw - drop_clear - drop_chamfer) / 2", "note": "each screw row off the centre line: midway between the groove and the key's side"}, {"name": "end_length", "expr": "max(corner_size; bevel * cos(45) + base_depth + depth - skin + drop_on + taper + 1)", "note": "the tongue, from the outside face"}, {"name": "end_inset", "expr": "bevel * cos(45) - skin + base_depth + depth + head_r + 1", "note": "the screw rows' end holes from the tongue's ends"}, {"name": "end_span", "expr": "end_length - 2 * end_inset", "note": "between the end holes"}, {"name": "end_holes", "expr": "end_span < min_spacing ? 1 : ceil(end_span / nominal_spacing) + 1", "note": "holes per row"}, {"name": "x0", "expr": "-(panel_t + skin)", "note": "the outside face"}, {"name": "face", "expr": "-panel_t - base_depth", "note": "the tongue's root"}, {"name": "tip", "expr": "face - depth", "note": "the tongue's tip"}, {"name": "z0", "expr": "x0 + bevel * cos(45)", "note": "the bevel at the outside face"}, {"name": "foot", "expr": "x0 + z0 - tip", "note": "the bevel's foot on the tip"}, {"name": "x1", "expr": "foot + drop_on", "note": "the drop-on's end"}, {"name": "x2", "expr": "x1 + taper", "note": "the taper's end"}, {"name": "key", "expr": "key_hw - drop_clear", "note": "the key's half-width"}, {"name": "out", "expr": "widest + 1", "note": "past the tongue's side"}],
      "checks": [{"expr": "notch >= 0 ? 1 : 0", "message": "notch must not be negative"}, {"expr": "end_span", "message": "the tongue is too short for its screw rows"}, {"expr": "drop_on", "message": "drop_on must be positive"}, {"expr": "taper", "message": "taper must be positive"}],
      "result": 56,
      "motion": [],
