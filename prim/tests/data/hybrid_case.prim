    {"name": "latch_base", "primitive": "rotary_latch", "bind": {}, "mirror": null, "colour": null, "pieces": ["base"], "print": true},
    {"name": "latch_knob", "primitive": "rotary_latch", "bind": {}, "mirror": null, "colour": [0.93, 0.66, 0.18], "pieces": ["knob"], "print": true},
