    "box_corner": {
      "format": "primlib.prim",
      "version": 1,
      "primitive": "box_corner",
      "title": "Box corner",
      "params": [{"name": "panel_t", "default": "6.5", "note": "the panels' thickness", "group": "Section"}, {"name": "skin", "default": "5", "note": "the wall over the panels' outsides", "group": "Section"}, {"name": "panel_gap", "default": "3", "note": "the web's width: how far the panels stop short of the inside corner", "group": "Section"}, {"name": "size", "default": "40", "note": "across the section, each way, from the outside face", "group": "Section"}, {"name": "bevel", "default": "15", "note": "the width of the big 45 degree bevel across the outside corner", "group": "Section"}, {"name": "chamfer", "default": "0.5", "note": "the small 45 degree chamfer on the outward square edges", "group": "Section"}, {"name": "glue", "default": "0", "note": "the glue line's thickness: how deep the pockets are behind the ridges; 0 for none", "group": "Section"}, {"name": "glue_ridge", "default": "0.6", "note": "the width of the ridges that hold a panel off the pockets' floor", "group": "Section"}, {"name": "drill_inset", "default": "6", "note": "the screw rows' first and last holes from the ends, and the rows' line from the panel's edge", "group": "Screws"}, {"name": "drill_spacing", "default": "12", "note": "between the holes, each way", "group": "Screws"}, {"name": "drill_rows", "default": "2", "note": "rows of holes each way, on each of the three faces", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "screw hole radius", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "countersink radius at the outside face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "countersink depth", "group": "Screws"}, {"name": "screw_len", "default": "20", "note": "the hole tool's length from the outside face", "group": "Screws"}],
