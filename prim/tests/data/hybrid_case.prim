        {"id": 14, "op": "beyond", "name": "relief_start", "normal": [-0.7071067811865475, 0.0, -0.7071067811865475], "d": "((((panel_t + skin) - relief + (relief > 0 ? 0 : 1000))) - chamfer) * 0.7071067812", "size": "(2 * length + 2 * size + 100)"},
        {"id": 15, "op": "beyond", "name": "relief_end", "normal": [-0.7071067811865475, 0.0, 0.7071067811865475], "d": "((((panel_t + skin) - relief + (relief > 0 ? 0 : 1000))) - chamfer + length) * 0.7071067812", "size": "(2 * length + 2 * size + 100)"},
        {"id": 16, "op": "beyond", "name": "relief_wall_end", "normal": [-0.7071067811865475, 0.7071067811865475, 0.0], "d": "((((panel_t + skin) - relief + (relief > 0 ? 0 : 1000))) - chamfer + reach) * 0.7071067812", "size": "(2 * length + 2 * size + 100)"},
        {"id": 17, "op": "cut", "name": null, "base": 0, "tools": [12, 1, 2, 3, 4, 13, 14, 15, 16]}
      ]
    },
    "rail_run": {
      "format": "primlib.prim",
      "version": 2,
      "kind": "recipe",
      "primitive": "rail_run",
      "title": "Rail run",
      "params": [{"name": "run", "default": "300", "note": "the length between the end pieces", "group": "Run"}, {"name": "key", "default": "'F", "note": "the sections in order: S, M, L fixed, F fit", "group": "Run"}, {"name": "fallback", "default": "'F", "note": "the key used when `key`'s fit section is under min_fit", "group": "Run"}, {"name": "small", "default": "20", "note": "an S section's length", "group": "Run"}, {"name": "medium", "default": "35", "note": "an M section's length", "group": "Run"}, {"name": "large", "default": "50", "note": "an L section's length", "group": "Run"}, {"name": "gap", "default": "0.2", "note": "between sections, and at each end", "group": "Run"}, {"name": "min_fit", "default": "10", "note": "the shortest fit section", "group": "Run"}, {"name": "base_depth", "default": "2", "note": "the support on the root, up from it", "group": "Rail"}, {"name": "printer_width_offset", "default": "0.2", "note": "topeak_rail's: added to its width in the model", "group": "Rail"}, {"name": "screws", "default": "1", "note": "1 for two rows of screws up through each section; 0 none", "group": "Screws"}, {"name": "screw_y", "default": "18.4", "note": "each row's line off the centre line", "group": "Screws"}, {"name": "drill_inset", "default": "6", "note": "the rows' first and last holes from the ends", "group": "Screws"}, {"name": "nominal_spacing", "default": "30", "note": "the longest pitch along a row", "group": "Screws"}, {"name": "min_spacing", "default": "7", "note": "under this between the end holes, a single middle hole", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "the screw hole", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "the countersink at the tip face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "the countersink's depth", "group": "Screws"}],
      "fixed": [],
      "derived": [{"name": "raw_fit", "expr": "count(key; <<F>>) > 0 ? (run - (len(key) + 1) * gap - count(key; <<S>>) * small - count(key; <<M>>) * medium - count(key; <<L>>) * large) / count(key; <<F>>) : 0", "note": "the fit length with the key as typed"}, {"name": "use", "expr": "raw_fit < min_fit ? fallback : key", "note": "the key in use: as typed, or the fallback"}, {"name": "fit_length", "expr": "count(use; <<F>>) > 0 ? (run - (len(use) + 1) * gap - count(use; <<S>>) * small - count(use; <<M>>) * medium - count(use; <<L>>) * large) / count(use; <<F>>) : 0", "note": "each fit section's length"}],
      "checks": [{"expr": "len(key) <= 7", "message": "key is longer than 7 letters"}, {"expr": "len(fallback) <= 7", "message": "fallback is longer than 7 letters"}, {"expr": "count(key; <<S>>) + count(key; <<M>>) + count(key; <<L>>) + count(key; <<F>>) == len(key)", "message": "key has a letter other than S M L F"}, {"expr": "count(fallback; <<S>>) + count(fallback; <<M>>) + count(fallback; <<L>>) + count(fallback; <<F>>) == len(fallback)", "message": "fallback has a letter other than S M L F"}, {"expr": "count(fallback; <<F>>)", "message": "fallback needs an F"}, {"expr": "fit_length >= min_fit", "message": "the run is too short, even with the fallback key"}],
      "slots": 7,
      "result": 0,
      "motion": [],
      "parts": [
        {"name": "S", "primitive": "topeak_rail", "bind": {"length": "small", "base_width": "-1", "end_taper": "0", "base_depth": "base_depth", "printer_width_offset": "printer_width_offset", "screws": "screws", "screw_y": "screw_y", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h"}, "mirror": null, "colour": [0.1, 0.62, 0.62], "pieces": null, "print": false},
        {"name": "M", "primitive": "topeak_rail", "bind": {"length": "medium", "base_width": "-1", "end_taper": "0", "base_depth": "base_depth", "printer_width_offset": "printer_width_offset", "screws": "screws", "screw_y": "screw_y", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h"}, "mirror": null, "colour": [0.93, 0.66, 0.18], "pieces": null, "print": false},
        {"name": "L", "primitive": "topeak_rail", "bind": {"length": "large", "base_width": "-1", "end_taper": "0", "base_depth": "base_depth", "printer_width_offset": "printer_width_offset", "screws": "screws", "screw_y": "screw_y", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h"}, "mirror": null, "colour": [0.78, 0.3, 0.42], "pieces": null, "print": false},
        {"name": "F", "primitive": "topeak_rail", "bind": {"length": "fit_length", "base_width": "-1", "end_taper": "0", "base_depth": "base_depth", "printer_width_offset": "printer_width_offset", "screws": "screws", "screw_y": "screw_y", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h"}, "mirror": null, "colour": [0.8, 0.8, 0.78], "pieces": null, "print": false}
      ],
      "place": [
        {"id": 0, "op": "row", "name": "rail", "key": "use", "pieces": {"S": {"part": "S", "length": "small"}, "M": {"part": "M", "length": "medium"}, "L": {"part": "L", "length": "large"}, "F": {"part": "F", "length": "fit_length"}}, "at": ["0", "0", "0"], "along": "x", "gap": "gap", "lead": "gap", "turn": []}
      ],
      "uses": {
        "topeak_rail": {
          "format": "primlib.prim",
          "version": 1,
          "primitive": "topeak_rail",
          "title": "Topeak rail",
          "params": [{"name": "length", "default": "20", "note": "along x", "group": "Variable"}, {"name": "base_depth", "default": "2", "note": "the depth of the support on the root, up from it", "group": "Variable"}, {"name": "base_width", "default": "-1", "note": "the width of the support; -1 (any negative): as wide as the root including its radius", "group": "Variable"}, {"name": "end_taper", "default": "0", "note": "lead-ins at both ends: 0 none; otherwise how far the profile changes at the very end, normal to its faces, over the same length along x, so at 45 deg", "group": "Variable"}, {"name": "printer_width_offset", "default": "0.2", "note": "added to the width in the model, half to each side, so that the part prints at its design width; 0.2 is PETG on the test printer, standing on end; not part of the fit", "group": "Variable"}, {"name": "screws", "default": "0", "note": "1 for two rows of countersunk holes up through the tongue, heads in the tip face, to screw it to a panel; 0 for none", "group": "Screws"}, {"name": "screw_y", "default": "18.4", "note": "each row's line off the centre line, along y", "group": "Screws"}, {"name": "drill_inset", "default": "6", "note": "the rows' first and last holes from the ends, along x", "group": "Screws"}, {"name": "nominal_spacing", "default": "30", "note": "the longest pitch along a row", "group": "Screws"}, {"name": "min_spacing", "default": "7", "note": "under this between the end holes, a single middle hole", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "screw hole radius", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "countersink radius at the tip face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "countersink depth, up from the tip face", "group": "Screws"}],
          "fixed": [{"name": "width", "expr": "61.4", "note": "the outside width, between vertical tangents to the tip radii, what calipers read on the print"}, {"name": "angle", "expr": "60", "note": "the slope of the sides, flank to the tip face, deg"}, {"name": "depth", "expr": "6.35", "note": "the depth of the tongue, root to tip (1/4\", set by the rack)"}, {"name": "tip_radius", "expr": "0.7", "note": "the radius of the two tip corners"}, {"name": "root_radius", "expr": "1", "note": "the radius of the two root corners"}, {"name": "groove_width", "expr": "19.95", "note": "the width of the centre groove at the tip face"}, {"name": "groove_depth", "expr": "1.2", "note": "the depth of the centre groove, up from the tip face"}, {"name": "groove_angle", "expr": "45", "note": "the slope of the groove's sides to the tip face, deg"}],
          "derived": [{"name": "t_tip", "expr": "tip_radius / tan(angle / 2)", "note": "tip radius's tangent length"}, {"name": "t_root", "expr": "root_radius / tan(angle / 2)", "note": "root radius's tangent length, into a base wider than the root"}, {"name": "tip_hw", "expr": "width / 2 + t_tip - tip_radius", "note": "tip half-width, sharp"}, {"name": "root_hw", "expr": "tip_hw - depth / tan(angle)", "note": "root half-width, sharp"}, {"name": "width_check", "expr": "2 * (tip_hw - t_tip + tip_radius)", "note": "the width, worked back from the sharp corners"}, {"name": "base_hw", "expr": "base_width < base_width * 0 ? root_hw + t_root : base_width / 2", "note": "the support's half-width"}, {"name": "span", "expr": "length - 2 * drill_inset", "note": "between the end holes"}, {"name": "holes", "expr": "span < min_spacing ? 1 : ceil(span / nominal_spacing) + 1", "note": "holes per row"}],
          "checks": [{"expr": "length", "message": "length must be positive"}, {"expr": "0.000001 - abs(width_check - width)", "message": "the tip radii don't come to the width"}, {"expr": "root_hw + printer_width_offset / 2", "message": "depth leaves no root"}, {"expr": "end_taper >= end_taper * 0 ? 1 : 0", "message": "end_taper can't be negative"}, {"expr": "tip_radius - end_taper", "message": "end_taper must be less than the tip radius"}, {"expr": "length - 2 * end_taper", "message": "length is too short for its two tapered ends"}, {"expr": "tip_hw - t_tip - groove_width / 2 - end_taper", "message": "the groove and the tip radii leave no tip face between them"}, {"expr": "base_depth", "message": "base_depth must be more than 0: the root radius needs the support"}, {"expr": "base_width < base_width * 0 ? 1 : base_width / 2 - root_hw - t_root", "message": "base_width is narrower than the root and its radius"}, {"expr": "screw_y - head_r - groove_width / 2", "message": "the screw heads break into the groove (screw_y)"}, {"expr": "tip_hw - t_tip - screw_y - head_r", "message": "the screw heads break out of the tip face (screw_y)"}, {"expr": "root_hw - screw_y - screw_r", "message": "the screw holes break out of the tongue's flanks (screw_y)"}, {"expr": "head_r - screw_r", "message": "head_r must be more than screw_r"}, {"expr": "depth - head_h", "message": "the countersink is deeper than the tongue"}, {"expr": "span", "message": "length is too short for drill_inset"}],
          "result": 18,
          "motion": [],
          "ops": [
            {"id": 0, "op": "loft", "name": "rail", "plane": "yz", "ruled": true, "sections": [{"points": [["-((tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["-(groove_width / 2 + (-(end_taper)) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle))", "-depth - (-(end_taper))"], ["-(groove_width / 2 - (groove_depth - (-(end_taper))) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle))", "-depth + groove_depth - (-(end_taper))"], ["groove_width / 2 - (groove_depth - (-(end_taper))) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle)", "-depth + groove_depth - (-(end_taper))"], ["groove_width / 2 + (-(end_taper)) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle)", "-depth - (-(end_taper))"], ["(tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "0"}, {"points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["-(groove_width / 2 + (-(0)) / tan(groove_angle) - (-(0)) / sin(groove_angle))", "-depth - (-(0))"], ["-(groove_width / 2 - (groove_depth - (-(0))) / tan(groove_angle) - (-(0)) / sin(groove_angle))", "-depth + groove_depth - (-(0))"], ["groove_width / 2 - (groove_depth - (-(0))) / tan(groove_angle) - (-(0)) / sin(groove_angle)", "-depth + groove_depth - (-(0))"], ["groove_width / 2 + (-(0)) / tan(groove_angle) - (-(0)) / sin(groove_angle)", "-depth - (-(0))"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "end_taper"}, {"points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["-(groove_width / 2 + (-(0)) / tan(groove_angle) - (-(0)) / sin(groove_angle))", "-depth - (-(0))"], ["-(groove_width / 2 - (groove_depth - (-(0))) / tan(groove_angle) - (-(0)) / sin(groove_angle))", "-depth + groove_depth - (-(0))"], ["groove_width / 2 - (groove_depth - (-(0))) / tan(groove_angle) - (-(0)) / sin(groove_angle)", "-depth + groove_depth - (-(0))"], ["groove_width / 2 + (-(0)) / tan(groove_angle) - (-(0)) / sin(groove_angle)", "-depth - (-(0))"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "length - end_taper"}, {"points": [["-((tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["-(groove_width / 2 + (-(end_taper)) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle))", "-depth - (-(end_taper))"], ["-(groove_width / 2 - (groove_depth - (-(end_taper))) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle))", "-depth + groove_depth - (-(end_taper))"], ["groove_width / 2 - (groove_depth - (-(end_taper))) / tan(groove_angle) - (-(end_ta