        {"id": 23, "op": "prism", "name": "glue_z_skin", "points": [["((-panel_t) + (glue > 0 ? 0 : 1000))", "(panel_gap + glue_ridge)"], ["((-panel_t) + (glue > 0 ? 0 : 1000))", "(reach - chamfer - glue_ridge)"], ["((-panel_t) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)", "(reach - chamfer - glue_ridge) - (glue > 0 ? glue : 0.01)"], ["((-panel_t) + (glue > 0 ? 0 : 1000)) - (glue > 0 ? glue : 0.01)", "(panel_gap + glue_ridge) + (glue > 0 ? glue : 0.01)"]], "plane": "zx", "span": ["panel_gap", "reach + 1"]},
