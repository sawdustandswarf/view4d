{
  "format": "primlib.prim",
  "version": 2,
  "kind": "assembly",
  "primitive": "hybrid_case",
  "title": "Hybrid case",
  "params": [{"name": "length", "default": "350", "note": "inside, along x", "group": "Box"}, {"name": "width", "default": "260", "note": "inside, along y", "group": "Box"}, {"name": "height", "default": "180", "note": "inside, along z", "group": "Box"}, {"name": "split_height", "default": "110", "note": "where the lid splits off, from the inside floor", "group": "Box"}, {"name": "open_angle", "default": "0", "note": "how far the lid is open, degrees; 0 shut", "group": "Box"}, {"name": "panel_t", "default": "6.5", "note": "the plywood's thickness", "group": "Box"}, {"name": "corner_size", "default": "40", "note": "a corner across each wall, from the outside face", "group": "Corners"}, {"name": "skin", "default": "5", "note": "the wall over the panels' outsides", "group": "Corners"}, {"name": "panel_gap", "default": "3", "note": "how far the panels stop short of the inside corner", "group": "Corners"}, {"name": "bevel", "default": "15", "note": "the 45 degree bevel across each outside edge", "group": "Corners"}, {"name": "chamfer", "default": "0.5", "note": "on the outward square edges", "group": "Corners"}, {"name": "glue", "default": "0", "note": "pockets this deep behind the ridges; 0 for none (plywood)", "group": "Corners"}, {"name": "glue_ridge", "default": "0.6", "note": "the ridges the panels sit on", "group": "Corners"}, {"name": "drill_rows", "default": "2", "note": "a corner's rows of holes each way, on each face", "group": "Screws"}, {"name": "drill_spacing", "default": "12", "note": "between a corner's holes, each way", "group": "Screws"}, {"name": "drill_inset", "default": "6", "note": "the first hole from the inside corner, past the panel gap", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "the screw hole", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "the countersink at the outside face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "the countersink's depth", "group": "Screws"}, {"name": "screw_len", "default": "20", "note": "the hole's length from the outside face", "group": "Screws"}, {"name": "edge_size", "default": "27", "note": "an edge across its section, from the outside face", "group": "Edges"}, {"name": "gap", "default": "0.2", "note": "between edge pieces, and between a piece and a corner", "group": "Edges"}, {"name": "min_fit", "default": "10", "note": "the shortest fit piece", "group": "Edges"}, {"name": "nominal_spacing", "default": "30", "note": "the longest screw pitch along an edge", "group": "Edges"}, {"name": "min_spacing", "default": "7", "note": "under this between an edge's end holes, one middle hole", "group": "Edges"}, {"name": "small", "default": "20", "note": "an S edge piece", "group": "Edges"}, {"name": "medium", "default": "35", "note": "an M edge piece", "group": "Edges"}, {"name": "large", "default": "50", "note": "an L edge piece", "group": "Edges"}, {"name": "key_x", "default": "'F", "note": "the X edges' pieces (along the length), from the left corner", "group": "Edges"}, {"name": "key_y", "default": "'F", "note": "the Y edges' pieces (along the width), from the front corner", "group": "Edges"}, {"name": "key_z_lower", "default": "'F", "note": "the Z edges' pieces below the split, from the bottom corner", "group": "Edges"}, {"name": "key_z_upper", "default": "'F", "note": "the Z edges' pieces above the split, from the split", "group": "Edges"}, {"name": "rail_on", "default": "1", "note": "1 shows the rail, 0 leaves it off", "group": "Rail"}, {"name": "key_rail", "default": "'F", "note": "the rail's middle sections, from the left end piece", "group": "Rail"}, {"name": "notch_width", "default": "125", "note": "across the bottom Y edges, centred, to clear the rack", "group": "Rail"}, {"name": "rack_gap", "default": "0.15", "note": "the rack's top face below the rail's root, seated", "group": "Rail"}, {"name": "notch_clear", "default": "1", "note": "the notch's face above the rack's top face", "group": "Rail"}, {"name": "drop_on", "default": "15", "note": "at each end, after the bevel: the tongue cut back to a key that drops into the rack", "group": "Rail"}, {"name": "taper", "default": "10", "note": "after the drop-on: the tongue widens back to full size", "group": "Rail"}, {"name": "drop_clear", "default": "0.5", "note": "the key inside the tongue's neck, each side", "group": "Rail"}, {"name": "drop_chamfer", "default": "1", "note": "45 degrees on the key's tip edges", "group": "Rail"}, {"name": "rail_screws", "default": "1", "note": "1: two rows of screws up through the rail into the bottom panel; 0 none", "group": "Rail"}, {"name": "key_hinge", "default": "'TFT", "note": "the hinge row, from the left rear Z edge: S, M, L, F, and T the little one", "group": "Hinges and latches"}, {"name": "hinge_pitch", "default": "10", "note": "the hinges' ring pitch; rings: the length over it, at least 2", "group": "Hinges and latches"}, {"name": "hinge_side", "default": "18", "note": "each hinge leaf beyond its tab", "group": "Hinges and latches"}, {"name": "hinge_little", "default": "13", "note": "the T hinge's length", "group": "Hinges and latches"}, {"name": "hinge_pitch_little", "default": "6.5", "note": "the T hinge's ring pitch", "group": "Hinges and latches"}, {"name": "latch_spacing", "default": "=length / 3", "note": "between the two latch knobs' axes, centred", "group": "Hinges and latches"}],
  "fixed": [{"name": "hinge_face", "expr": "7.5", "note": "the hinge's axis to its mounting faces (pin_d / 2 + pin_gap + ring_wall + backset): the lid's hinge line behind the rear panels"}, {"name": "rail_w", "expr": "61.6", "note": "topeak_rail's modelled width (61.4 printed, its printer_width_offset 0.2)"}, {"name": "rail_depth", "expr": "6.35", "note": "topeak_rail's tongue, root to tip"}, {"name": "hinge_half", "expr": "7", "note": "a hinge's axis to its leaf's side plate (plate / 2)"}, {"name": "latch_plate", "expr": "80", "note": "rotary_latch's plate width"}, {"name": "latch_joint", "expr": "7.6", "note": "rotary_latch's joint_y: its split line above its origin"}, {"name": "rail_key_hw", "expr": "61.4 / 2 + 0.7 / tan(30) - 0.7 - 6.35 / tan(60) + 1 / tan(30) - 1", "note": "topeak_rail's root half-width with its radius: the drop-on key's at the neck"}],
  "derived": [{"name": "reach", "expr": "corner_size - (panel_t + skin)", "note": "how far a corner reaches along an edge from the inside face"}, {"name": "panel_l", "expr": "length - 2 * panel_gap", "note": "the bottom, top, front and rear panels' length"}, {"name": "panel_w", "expr": "width - 2 * panel_gap", "note": "the bottom, top, left and right panels' width"}, {"name": "lower_h", "expr": "split_height - panel_gap", "note": "the side panels' height below the split"}, {"name": "upper_h", "expr": "height - split_height - panel_gap", "note": "the side panels' height above the split"}, {"name": "hinge_y", "expr": "width + panel_t + hinge_face", "note": "the hinge line, front to back"}, {"name": "rail_dropped", "expr": "(width - notch_width) / 2 - reach - 1.5 * gap < min_fit ? 1 : 0", "note": "1: too narrow for the notch; the rail drops below the edges, which aren't cut"}, {"name": "rail_base", "expr": "rail_dropped > 0 ? max(2; skin - rack_gap + notch_clear) : 2", "note": "the rail's support: dropped, deep enough that the rack passes notch_clear under the edges"}, {"name": "rail_span", "expr": "rail_dropped > 0 ? rail_w + gap : notch_width", "note": "the notch; dropped, no notch pieces: plain pieces from the corners to the end piece"}, {"name": "rail_plain", "expr": "(width - rail_span) / 2 - reach - 1.5 * gap", "note": "a plain piece, from the corner to the notch"}, {"name": "rail_show", "expr": "rail_on > 0 ? (rail_plain < min_fit - 0.001 ? 0 : 1) : 0", "note": "rail_on, unless the box is too narrow for even the dropped rail's pieces"}, {"name": "rail_notch", "expr": "(rail_span - rail_w) / 2 - 1.5 * gap", "note": "a notched piece, from the notch's end to the end piece"}, {"name": "notch_depth", "expr": "rail_dropped > 0 ? 0 : skin - rail_base - rack_gap + notch_clear", "note": "cut from the bottom Y edges' underside"}, {"name": "end_length", "expr": "max(corner_size; bevel * cos(45) + rail_base + rail_depth - skin + drop_on + taper + 1)", "note": "an end piece's tongue, from the outside face"}, {"name": "rail_run", "expr": "length + 2 * (panel_t + skin) - 2 * end_length", "note": "between the end pieces"}, {"name": "rail_screw_y", "expr": "(19.95 / 2 + rail_key_hw - drop_clear - drop_chamfer) / 2", "note": "each screw row off the centre line: midway between the groove and the drop-on key's side"}, {"name": "edge_reach", "expr": "edge_size - (panel_t + skin)", "note": "how far an edge reaches along a wall from the inside face"}, {"name": "hinge_run", "expr": "length - 2 * edge_reach", "note": "the hinge row, between the rear Z edges"}, {"name": "hinge_a_little", "expr": "min(hinge_side; height - split_height - reach - gap - hinge_half)", "note": "the T hinge's lid leaf: as the others, or short of the top corner by the gap"}, {"name": "hinge_b_little", "expr": "min(hinge_side; split_height - reach - gap - hinge_half)", "note": "the T hinge's base leaf: as the others, or short of the bottom corner by the gap"}, {"name": "n0", "expr": "(width - rail_span) / 2", "note": "the notch's front end"}, {"name": "y0", "expr": "(width - rail_w) / 2", "note": "the end piece's front side"}],
  "checks": [{"expr": "split_height - reach", "message": "the split is inside the bottom corners: raise split_height"}, {"expr": "height - split_height - reach", "message": "the split is inside the top corners: lower split_height"}, {"expr": "height - split_height - edge_reach - hinge_half - hinge_side >= 0 ? 1 : 0", "message": "the lid is too short for the hinge leaves: lower split_height or hinge_side"}, {"expr": "split_height - edge_reach - hinge_half - hinge_side >= 0 ? 1 : 0", "message": "the base is too short for the hinge leaves: raise split_height or lower hinge_side"}, {"expr": "hinge_a_little >= 0 ? 1 : 0", "message": "the lid is too short for the T hinge"}, {"expr": "hinge_b_little >= 0 ? 1 : 0", "message": "the base is too short for the T hinge"}, {"expr": "latch_spacing >= latch_plate + gap ? 1 : 0", "message": "the latches overlap: raise latch_spacing"}, {"expr": "(length - latch_spacing - latch_plate) / 2 >= edge_reach ? 1 : 0", "message": "a latch reaches a front Z edge: lower latch_spacing"}],
  "slots": 8,
  "result": 63,
  "motion": [],
  "parts": [
    {"name": "corner", "primitive": "box_corner", "bind": {"size": "corner_size", "drill_rows": "drill_rows", "drill_spacing": "drill_spacing", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": [0.25, 0.3, 0.38], "pieces": null, "print": true},
    {"name": "edge_x", "primitive": "edge_run", "bind": {"run": "length - 2 * reach", "key": "key_x", "fallback": "<<F>>", "small": "small", "medium": "medium", "large": "large", "gap": "gap", "min_fit": "min_fit", "lead_gap": "1", "end_gap": "1", "size": "edge_size", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": null, "pieces": null, "print": true},
    {"name": "edge_y", "primitive": "edge_run", "bind": {"run": "width - 2 * reach", "key": "key_y", "fallback": "<<F>>", "small": "small", "medium": "medium", "large": "large", "gap": "gap", "min_fit": "min_fit", "lead_gap": "1", "end_gap": "1", "size": "edge_size", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": null, "pieces": null, "print": true},
    {"name": "edge_z_lower", "primitive": "edge_run", "bind": {"run": "split_height - reach", "key": "key_z_lower", "fallback": "<<F>>", "small": "small", "medium": "medium", "large": "large", "gap": "gap", "min_fit": "min_fit", "lead_gap": "1", "end_gap": "0", "size": "edge_size", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": null, "pieces": null, "print": true},
    {"name": "edge_z_upper", "primitive": "edge_run", "bind": {"run": "height - split_height - reach", "key": "key_z_upper", "fallback": "<<F>>", "small": "small", "medium": "medium", "large": "large", "gap": "gap", "min_fit": "min_fit", "lead_gap": "0", "end_gap": "1", "size": "edge_size", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": null, "pieces": null, "print": true},
    {"name": "rail_end", "primitive": "rail_end", "bind": {"size": "edge_size", "notch": "notch_depth", "corner_size": "corner_size", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screws": "rail_screws", "base_depth": "rail_base", "drop_on": "drop_on", "taper": "taper", "drop_clear": "drop_clear", "drop_chamfer": "drop_chamfer", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": null, "pieces": null, "print": true},
    {"name": "rail_plain", "primitive": "box_edge", "bind": {"length": "max(rail_plain; min_fit)", "size": "edge_size", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": [0.8, 0.8, 0.78], "pieces": null, "print": true},
    {"name": "rail_notch", "primitive": "box_edge", "bind": {"length": "max(rail_notch; min_fit)", "size": "edge_size", "relief": "notch_depth", "holes_x": "0", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": [0.8, 0.8, 0.78], "pieces": null, "print": true},
    {"name": "sections", "primitive": "rail_run", "bind": {"run": "rail_run", "key": "key_rail", "fallback": "<<F>>", "small": "small", "medium": "medium", "large": "large", "gap": "gap", "min_fit": "min_fit", "base_depth": "rail_base", "screws": "rail_screws", "screw_y": "rail_screw_y", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h"}, "mirror": null, "colour": null, "pieces": null, "print": true},
