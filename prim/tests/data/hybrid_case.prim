      "checks": [{"expr": "length - 2 * chamfer", "message": "length is too short for its chamfers"}, {"expr": "chamfer", "message": "chamfer must be positive"}, {"expr": "skin - 2 * chamfer", "message": "skin is too thin for its chamfers"}, {"expr": "panel_gap - 2 * chamfer", "message": "panel_gap is too small for its chamfers"}, {"expr": "reach - panel_gap - 2 * chamfer", "message": "size is too small to leave a rebate"}, {"expr": "reach - inset - head_r", "message": "the screw heads break out of the skin's edge"}, {"expr": "2 * (panel_t + skin) - bevel / 1.4142135624 - 2 * chamfer", "message": "bevel is too wide"}, {"expr": "glue >= 0 ? 1 : 0", "message": "glue must not be negative"}, {"expr": "glue_ridge", "message": "glue_ridge must be positive"}, {"expr": "skin - glue - 2 * chamfer", "message": "glue leaves the skin too thin"}, {"expr": "panel_gap - glue - 2 * chamfer", "message": "glue leaves the web too thin"}, {"expr": "panel_t - chamfer - 2 * glue_ridge - 2 * glue", "message": "the panel's edge is too thin for its ridges"}, {"expr": "relief >= 0 ? 1 : 0", "message": "relief must not be negative"}, {"expr": "skin - relief - 2 * chamfer", "message": "relief leaves the -x wall too thin"}, {"expr": "bevel / 1.4142135624 - relief - chamfer", "message": "relief reaches past the bevel"}, {"expr": "reach - chamfer - panel_gap - 2 * glue_ridge - 2 * glue", "message": "the rebate is too narrow for its ridges"}],
