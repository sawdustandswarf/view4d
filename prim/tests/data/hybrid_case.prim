    "edge_run": {
      "format": "primlib.prim",
      "version": 2,
      "kind": "recipe",
      "primitive": "edge_run",
      "title": "Edge run",
      "params": [{"name": "run", "default": "300", "note": "the length between the corners", "group": "Run"}, {"name": "key", "default": "'SFMF", "note": "the pieces in order: S, M, L fixed, F fit", "group": "Run"}, {"name": "fallback", "default": "'F", "note": "the key used when `key`'s fit piece is under min_fit", "group": "Run"}, {"name": "small", "default": "30", "note": "an S piece's length", "group": "Run"}, {"name": "medium", "default": "60", "note": "an M piece's length", "group": "Run"}, {"name": "large", "default": "90", "note": "an L piece's length", "group": "Run"}, {"name": "gap", "default": "0.2", "note": "between pieces, and between a piece and a corner", "group": "Run"}, {"name": "min_fit", "default": "10", "note": "the shortest fit piece", "group": "Run"}, {"name": "lead_gap", "default": "1", "note": "1: a gap before the first piece (at a corner); 0: flush", "group": "Run"}, {"name": "end_gap", "default": "1", "note": "1: a gap after the last piece (at a corner); 0: flush", "group": "Run"}, {"name": "size", "default": "27", "note": "the edge's section, each way", "group": "Section"}, {"name": "panel_t", "default": "6.5", "note": "the panels' thickness", "group": "Section"}, {"name": "skin", "default": "5", "note": "the wall over the panels", "group": "Section"}, {"name": "panel_gap", "default": "3", "note": "the web's width", "group": "Section"}, {"name": "bevel", "default": "15", "note": "the outside bevel's width", "group": "Section"}, {"name": "chamfer", "default": "0.5", "note": "on the outward square edges", "group": "Section"}, {"name": "glue", "default": "0", "note": "the glue line's pockets behind the ridges; 0 for none", "group": "Section"}, {"name": "glue_ridge", "default": "0.6", "note": "the ridges the panels sit on", "group": "Section"}, {"name": "drill_inset", "default": "6", "note": "the screw rows from the inside corner, past the web", "group": "Screws"}, {"name": "nominal_spacing", "default": "30", "note": "the longest pitch along a screw row", "group": "Screws"}, {"name": "min_spacing", "default": "7", "note": "under this between the end holes, one middle hole", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "the screw hole", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "the countersink at the outside face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "the countersink's depth", "group": "Screws"}, {"name": "screw_len", "default": "20", "note": "the hole's length from the outside face", "group": "Screws"}],
      "fixed": [],
      "derived": [{"name": "raw_fit", "expr": "count(key; <<F>>) > 0 ? (run - (len(key) - 1 + lead_gap + end_gap) * gap - count(key; <<S>>) * small - count(key; <<M>>) * medium - count(key; <<L>>) * large) / count(key; <<F>>) : 0", "note": "the fit length with the key as typed"}, {"name": "use", "expr": "raw_fit < min_fit ? fallback : key", "note": "the key in use: as typed, or the fallback"}, {"name": "fit_length", "expr": "count(use; <<F>>) > 0 ? (run - (len(use) - 1 + lead_gap + end_gap) * gap - count(use; <<S>>) * small - count(use; <<M>>) * medium - count(use; <<L>>) * large) / count(use; <<F>>) : 0", "note": "each fit piece's length"}],
      "checks": [{"expr": "len(key) <= 7", "message": "key is longer than 7 letters"}, {"expr": "len(fallback) <= 7", "message": "fallback is longer than 7 letters"}, {"expr": "count(key; <<S>>) + count(key; <<M>>) + count(key; <<L>>) + count(key; <<F>>) == len(key)", "message": "key has a letter other than S M L F"}, {"expr": "count(fallback; <<S>>) + count(fallback; <<M>>) + count(fallback; <<L>>) + count(fallback; <<F>>) == len(fallback)", "message": "fallback has a letter other than S M L F"}, {"expr": "count(fallback; <<F>>)", "message": "fallback needs an F"}, {"expr": "fit_length >= min_fit", "message": "the run is too short, even with the fallback key"}],
      "slots": 7,
      "result": 0,
      "motion": [],
      "parts": [
        {"name": "S", "primitive": "box_edge", "bind": {"length": "small", "size": "size", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": [0.1, 0.62, 0.62], "pieces": null, "print": false},
        {"name": "M", "primitive": "box_edge", "bind": {"length": "medium", "size": "size", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": [0.93, 0.66, 0.18], "pieces": null, "print": false},
        {"name": "L", "primitive": "box_edge", "bind": {"length": "large", "size": "size", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": [0.78, 0.3, 0.42], "pieces": null, "print": false},
        {"name": "F", "primitive": "box_edge", "bind": {"length": "fit_length", "size": "size", "panel_t": "panel_t", "skin": "skin", "panel_gap": "panel_gap", "bevel": "bevel", "chamfer": "chamfer", "glue": "glue", "glue_ridge": "glue_ridge", "drill_inset": "drill_inset", "nominal_spacing": "nominal_spacing", "min_spacing": "min_spacing", "screw_r": "screw_r", "head_r": "head_r", "head_h": "head_h", "screw_len": "screw_len"}, "mirror": null, "colour": [0.8, 0.8, 0.78], "pieces": null, "print": false}
      ],
      "place": [
        {"id": 0, "op": "row", "name": "edge", "key": "use", "pieces": {"S": {"part": "S", "length": "small"}, "M": {"part": "M", "length": "medium"}, "L": {"part": "L", "length": "large"}, "F": {"part": "F", "length": "fit_length"}}, "at": ["0", "0", "0"], "along": "z", "gap": "gap", "lead": "lead_gap * gap", "turn": []}
      ],
      "uses": {
        "box_edge": {
          "format": "primlib.prim",
          "version": 1,
          "primitive": "box_edge",
          "title": "Box edge",
          "params": [{"name": "length", "default": "100", "note": "along the edge", "group": "Length"}, {"name": "panel_t", "default": "6.5", "note": "the panels' thickness", "group": "Section"}, {"name": "skin", "default": "5", "note": "the wall over the panels' outsides", "group": "Section"}, {"name": "panel_gap", "default": "3", "note": "the web's width: how far the panels stop short of the inside corner", "group": "Section"}, {"name": "size", "default": "27", "note": "across the section, each way, from the outside face", "group": "Section"}, {"name": "bevel", "default": "15", "note": "the width of the big 45 degree bevel across the outside corner", "group": "Section"}, {"name": "chamfer", "default": "0.5", "note": "the small 45 degree chamfer on the outward square edges", "group": "Section"}, {"name": "glue", "default": "0", "note": "the glue line's thickness: how deep the pockets are behind the ridges; 0 for none", "group": "Section"}, {"name": "glue_ridge", "default": "0.6", "note": "the width of the ridges that hold a panel off the pockets' floor", "group": "Section"}, {"name": "relief", "default": "0", "note": "the -x wall's outside face cut back by this, across the whole section, its small chamfers carried round; 0 for none", "group": "Section"}, {"name": "drill_inset", "default": "6", "note": "the screw rows' first and last holes from the ends, and the rows' line from the panel's edge", "group": "Screws"}, {"name": "nominal_spacing", "default": "30", "note": "the longest pitch along a row", "group": "Screws"}, {"name": "min_spacing", "default": "7", "note": "under this between the end holes, a single middle hole", "group": "Screws"}, {"name": "screw_r", "default": "1.4", "note": "screw hole radius", "group": "Screws"}, {"name": "head_r", "default": "2.75", "note": "countersink radius at the outside face", "group": "Screws"}, {"name": "head_h", "default": "2.7", "note": "countersink depth", "group": "Screws"}, {"name": "screw_len", "default": "20", "note": "the hole tool's length from the outside face", "group": "Screws"}, {"name": "holes_x", "default": "1", "note": "1 for the row through the -x wall, 0 for none", "group": "Screws"}, {"name": "holes_y", "default": "1", "note": "1 for the row through the -y wall, 0 for none", "group": "Screws"}],
          "fixed": [],
