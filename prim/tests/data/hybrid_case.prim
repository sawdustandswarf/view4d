            {"id": 1, "op": "prism", "name": "rail", "points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["-(groove_width / 2 + (-(0)) / tan(groove_angle) - (-(0)) / sin(groove_angle))", "-depth - (-(0))"], ["-(groove_width / 2 - (groove_depth - (-(0))) / tan(groove_angle) - (-(0)) / sin(groove_angle))", "-depth + groove_depth - (-(0))"], ["groove_width / 2 - (groove_depth - (-(0))) / tan(groove_angle) - (-(0)) / sin(groove_angle)", "-depth + groove_depth - (-(0))"], ["groove_width / 2 + (-(0)) / tan(groove_angle) - (-(0)) / sin(groove_angle)", "-depth - (-(0))"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)", "tip_radius - (0)"], ["(root_hw - (0) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw) + printer_width_offset / 2", "0"], ["(base_hw) + printer_width_offset / 2", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "base_depth"], ["-((base_hw) + printer_width_offset / 2)", "0"], ["-((root_hw - (0) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "plane": "yz", "span": ["0", "length"]},
            {"id": 2, "op": "choose", "name": null, "guard": "end_taper > 0", "then": 0, "otherwise": 1},
            {"id": 3, "op": "loft", "name": "rail", "plane": "yz", "ruled": true, "sections": [{"points": [["-((tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["-(groove_width / 2 + (-(end_taper)) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle))", "-depth - (-(end_taper))"], ["-(groove_width / 2 - (groove_depth - (-(end_taper))) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle))", "-depth + groove_depth - (-(end_taper))"], ["groove_width / 2 - (groove_depth - (-(end_taper))) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle)", "-depth + groove_depth - (-(end_taper))"], ["groove_width / 2 + (-(end_taper)) / tan(groove_angle) - (-(end_taper)) / sin(groove_angle)", "-depth - (-(end_taper))"], ["(tip_hw - (end_taper) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (end_taper)", "tip_radius - (end_taper)"], ["(root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2", "0", "root_radius"], ["(base_hw + 1) + printer_width_offset / 2", "0"], ["(base_hw + 1) + printer_width_offset / 2", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "base_depth"], ["-((base_hw + 1) + printer_width_offset / 2)", "0"], ["-((root_hw - (end_taper) / sin(angle)) + printer_width_offset / 2)", "0", "root_radius"]], "at": "0"}, {"points": [["-((tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2)", "-depth + (0)", "tip_radius - (0)"], ["-(groove_width / 2 + (-(0)) / tan(groove_angle) - (-(0)) / sin(groove_angle))", "-depth - (-(0))"], ["-(groove_width / 2 - (groove_depth - (-(0))) / tan(groove_angle) - (-(0)) / sin(groove_angle))", "-depth + groove_depth - (-(0))"], ["groove_width / 2 - (groove_depth - (-(0))) / tan(groove_angle) - (-(0)) / sin(groove_angle)", "-depth + groove_depth - (-(0))"], ["groove_width / 2 + (-(0)) / tan(groove_angle) - (-(0)) / sin(groove_angle)", "-depth - (-(0))"], ["(tip_hw - (0) / tan(angle / 2)) + printer_width_offset / 2", "-depth + (0)"