{
  "format": "primlib.prim",
  "version": 1,
  "primitive": "twist_socket",
  "title": "Twist socket",
  "params": [{"name": "mouth_d", "default": "30", "note": "socket mouth diameter, at the lip's sharp inner edge", "group": "Taper"}, {"name": "depth", "default": "3.5", "note": "socket depth, face to floor", "group": "Taper"}, {"name": "taper_angle", "default": "60", "note": "undercut flank's angle to the face, deg", "group": "Taper"}, {"name": "radius", "default": "0.8", "note": "round on the socket's floor corner and the lugs' root; the mouth and the lug tips take radius - tol", "group": "Taper"}, {"name": "tol", "default": "0.3", "note": "clearance: radial at the shaft, the lug tips and the openings, axial at the floor; also how much smaller the convex rounds are", "group": "Fit"}, {"name": "preload", "default": "0.2", "note": "the lugs' flanks are this much too high (along the axis) when the faces touch: the pull when locked", "group": "Fit"}, {"name": "lugs", "default": "3", "note": "number of lugs and openings", "group": "Lugs"}, {"name": "lug_angle", "default": "40", "note": "each lug's arc, deg", "group": "Lugs"}, {"name": "twist", "default": "60", "note": "turn from entry to locked, deg, clockwise seen from the plug", "group": "Lugs"}, {"name": "open_clr", "default": "3", "note": "openings' angular clearance past the lugs each side, deg", "group": "Lugs"}, {"name": "lead", "default": "1", "note": "each lug's flank lowered this much at its leading end, so it starts under the lip clear", "group": "Lugs"}, {"name": "lead_angle", "default": "12", "note": "arc over which the lead runs out to the full flank, deg", "group": "Lugs"}, {"name": "body_d", "default": "50", "note": "socket boss and plug flange diameter", "group": "Body"}, {"name": "body_t", "default": "5", "note": "socket boss thickness, below the face", "group": "Body"}, {"name": "flange_t", "default": "2", "note": "plug flange thickness, above the face", "group": "Body"}, {"name": "detent_r", "default": "1", "note": "detent bump's sphere radius", "group": "Detent"}, {"name": "detent_h", "default": "0.4", "note": "detent bump's height above the socket face", "group": "Detent"}, {"name": "detent_pos", "default": "=(mouth_d + body_d) / 4", "note": "detent's distance from the axis", "group": "Detent"}, {"name": "detent_angle", "default": "=lug_angle / 2", "note": "detent's angle (one per lug), deg", "group": "Detent"}, {"name": "overlap", "default": "1", "note": "how far tools reach past a face, for clean booleans", "group": "Span"}],
  "fixed": [],
  "derived": [{"name": "m", "expr": "mouth_d / 2", "note": "mouth radius"}, {"name": "floor_r", "expr": "m + depth / tan(taper_angle)", "note": "floor radius, at the flank's foot"}, {"name": "r_small", "expr": "radius - tol", "note": "the convex rounds: socket mouth and lug tips"}, {"name": "mouth_t", "expr": "r_small / tan(taper_angle / 2)", "note": "tangent length of the mouth round"}, {"name": "root_t", "expr": "radius / tan(taper_angle / 2)", "note": "tangent length of the lug root round"}, {"name": "shaft_r", "expr": "m - tol", "note": "plug shaft radius"}, {"name": "lug_z", "expr": "tol - depth", "note": "lugs' underside, tol off the floor"}],
  "checks": [{"expr": "r_small", "message": "radius must be more than tol"}, {"expr": "body_t - depth", "message": "body_t leaves no floor under the socket"}, {"expr": "body_d / 2 - floor_r - tol - 1", "message": "body_d leaves under 1 of wall round the socket"}, {"expr": "twist - open_clr - lug_angle", "message": "a locked lug still overlaps its opening (twist too small)"}, {"expr": "360 / lugs - twist - lug_angle - open_clr", "message": "a locked lug overlaps the next opening (twist or lug_angle too big)"}, {"expr": "lug_angle - lead_angle", "message": "lead_angle must be less than lug_angle"}, {"expr": "lead - preload", "message": "lead must be more than preload, or the lugs can't start under the lips"}, {"expr": "detent_pos - detent_r - m - mouth_t", "message": "the detent is inside the mouth"}, {"expr": "body_d / 2 - detent_pos - detent_r", "message": "the detent is off the boss"}],
  "result": 7,
  "motion": [],
  "ops": [
    {"id": 0, "op": "cylinder", "name": "body", "axis": "z", "centre": ["0", "0"], "r": "body_d / 2", "span": ["-body_t", "0"]},
    {"id": 1, "op": "sphere", "name": "bump", "centre": ["detent_pos * cos(detent_angle)", "detent_pos * sin(detent_angle)", "detent_h - detent_r"], "r": "detent_r"},
    {"id": 2, "op": "polar", "name": "bumps", "base": 1, "count": "lugs", "angle": "360"},
    {"id": 3, "op": "revolve", "name": "socket", "points": [["0", "-depth"], ["floor_r", "-depth", "radius"], ["m", "0", "r_small"], ["m + mouth_t + overlap", "0"], ["m + mouth_t + overlap", "overlap"], ["0", "overlap"]], "span": ["0", "360"]},
    {"id": 4, "op": "revolve", "name": "opening", "points": [["m - 1", "-depth"], ["floor_r + tol", "-depth"], ["floor_r + tol", "overlap"], ["m - 1", "overlap"]], "span": ["twist - open_clr", "twist + lug_angle + open_clr"]},
    {"id": 5, "op": "polar", "name": "openings", "base": 4, "count": "lugs", "angle": "360"},
    {"id": 6, "op": "fuse", "name": "boss", "of": [0, 2]},
    {"id": 7, "op": "cut", "name": null, "base": 6, "tools": [3, 5]}
  ]
}
