{
  "format": "primlib.prim",
  "version": 1,
  "primitive": "support_rect",
  "title": "Rectangle support",
  "params": [{"name": "length", "default": "20", "note": "length of the support, along x", "group": null}, {"name": "width", "default": "10", "note": "width of the support, along y", "group": null}, {"name": "height", "default": "3", "note": "face below (z = 0) to the supported face, along z", "group": null}, {"name": "line_w", "default": "0.44", "note": "print line width", "group": null}, {"name": "layer_h", "default": "0.2", "note": "print layer height: each interface layer's thickness", "group": null}, {"name": "wall_lines", "default": "1", "note": "wall width, in line widths", "group": null}, {"name": "gap_lines", "default": "4", "note": "gap between walls, in line widths", "group": null}, {"name": "interface_density", "default": "0.33", "note": "interface layers' strips, as a share of their area", "group": null}, {"name": "interface_gap", "default": "0.1", "note": "top interface layer to the supported face", "group": null}, {"name": "bottom_gap", "default": "=interface_gap", "note": "face below to the bottom interface layer (0 on the bed)", "group": null}],
  "fixed": [],
  "derived": [{"name": "wall", "expr": "wall_lines * line_w", "note": "wall width"}, {"name": "gap", "expr": "gap_lines * line_w", "note": "gap between walls"}, {"name": "pitch", "expr": "wall + gap", "note": "ring spacing"}, {"name": "long_x", "expr": "(length >= width ? 1 : 0)", "note": "1 if the long side is along x"}, {"name": "short", "expr": "(long_x > 0 ? width : length)", "note": "short side"}, {"name": "long", "expr": "(long_x > 0 ? length : width)", "note": "long side"}, {"name": "rings", "expr": "max(1; floor((short / 2 - wall - gap / 2) / pitch) + 1)", "note": "number of rings: as many as leave a gap across the middle"}, {"name": "inset", "expr": "(rings - 1) * pitch", "note": "innermost ring in from the outside"}, {"name": "hollow", "expr": "short - 2 * (inset + wall)", "note": "middle, across the short side"}, {"name": "middle", "expr": "(hollow > gap + wall ? 1 : 0)", "note": "1 if there is a middle line"}, {"name": "mid_lo", "expr": "(middle > 0 ? (short - wall) / 2 : inset)", "note": "middle line's side, across the short side"}, {"name": "wall_lo", "expr": "bottom_gap + layer_h", "note": "walls' bottom, on the bottom interface layer"}, {"name": "wall_hi", "expr": "height - interface_gap - layer_h", "note": "walls' top, under the top interface layer"}, {"name": "strip_pitch", "expr": "line_w / interface_density", "note": "interface strip spacing"}, {"name": "strip_gap", "expr": "strip_pitch - line_w", "note": "gap between interface strips"}, {"name": "strips", "expr": "max(1; floor((long / 2 - line_w - strip_gap / 2) / strip_pitch) + 1)", "note": "interface strips in from each end: as many as leave a gap across the middle"}, {"name": "strip_in", "expr": "(strips - 1) * strip_pitch", "note": "innermost strip in from its end"}, {"name": "strip_mid", "expr": "(long - 2 * (strip_in + line_w) > strip_pitch ? (long - line_w) / 2 : strip_in)", "note": "middle strip's side along the long side (on the innermost strip if none)"}],
  "checks": [],
  "result": 37,
  "motion": [],
  "ops": [
    {"id": 0, "op": "box", "name": "stripe_x_lo", "x": ["0", "wall"], "y": ["0", "width"], "z": ["wall_lo", "wall_hi"]},
    {"id": 1, "op": "array", "name": "stripes_x_lo", "base": 0, "along": {"x": {"count": "rings", "start": "0", "step": "pitch"}}},
    {"id": 2, "op": "box", "name": "stripe_x_hi", "x": ["0", "wall"], "y": ["0", "width"], "z": ["wall_lo", "wall_hi"]},
    {"id": 3, "op": "array", "name": "stripes_x_hi", "base": 2, "along": {"x": {"count": "rings", "start": "length - wall", "step": "-pitch"}}},
    {"id": 4, "op": "box", "name": "stripe_y_lo", "x": ["0", "length"], "y": ["0", "wall"], "z": ["wall_lo", "wall_hi"]},
    {"id": 5, "op": "array", "name": "stripes_y_lo", "base": 4, "along": {"y": {"count": "rings", "start": "0", "step": "pitch"}}},
    {"id": 6, "op": "box", "name": "stripe_y_hi", "x": ["0", "length"], "y": ["0", "wall"], "z": ["wall_lo", "wall_hi"]},
    {"id": 7, "op": "array", "name": "stripes_y_hi", "base": 6, "along": {"y": {"count": "rings", "start": "width - wall", "step": "-pitch"}}},
    {"id": 8, "op": "prism", "name": "near_x_lo", "points": [["0", "0"], ["width / 2", "width / 2"], ["0", "width"]], "plane": "xy", "span": ["wall_lo", "wall_hi"]},
    {"id": 9, "op": "prism", "name": "near_x_hi", "points": [["length", "0"], ["length", "width"], ["length - width / 2", "width / 2"]], "plane": "xy", "span": ["wall_lo", "wall_hi"]},
    {"id": 10, "op": "prism", "name": "near_y_lo", "points": [["0", "0"], ["length", "0"], ["length / 2", "length / 2"]], "plane": "xy", "span": ["wall_lo", "wall_hi"]},
    {"id": 11, "op": "prism", "name": "near_y_hi", "points": [["0", "width"], ["length / 2", "width - length / 2"], ["length", "width"]], "plane": "xy", "span": ["wall_lo", "wall_hi"]},
    {"id": 12, "op": "fuse", "name": "stripes_x", "of": [1, 3]},
    {"id": 13, "op": "fuse", "name": "near_x", "of": [8, 9]},
    {"id": 14, "op": "common", "name": "sides_x", "of": [12, 13]},
    {"id": 15, "op": "fuse", "name": "stripes_y", "of": [5, 7]},
    {"id": 16, "op": "fuse", "name": "near_y", "of": [10, 11]},
    {"id": 17, "op": "common", "name": "sides_y", "of": [15, 16]},
    {"id": 18, "op": "box", "name": "middle_line", "x": ["long_x > 0 ? inset + wall : mid_lo", "long_x > 0 ? length - inset - wall : mid_lo + wall"], "y": ["long_x > 0 ? mid_lo : inset + wall", "long_x > 0 ? mid_lo + wall : width - inset - wall"], "z": ["wall_lo", "wall_hi"]},
    {"id": 19, "op": "box", "name": "bottom_strip_lo", "x": ["0", "long_x > 0 ? line_w : length"], "y": ["0", "long_x > 0 ? width : line_w"], "z": ["bottom_gap", "wall_lo"]},
    {"id": 20, "op": "array", "name": "bottom_strips_lo", "base": 19, "along": {"x": {"count": "long_x > 0 ? strips : 1", "start": "long_x > 0 ? 0 : 0", "step": "strip_pitch"}, "y": {"count": "long_x > 0 ? 1 : strips", "start": "long_x > 0 ? 0 : 0", "step": "strip_pitch"}}},
    {"id": 21, "op": "box", "name": "bottom_strip_hi", "x": ["0", "long_x > 0 ? line_w : length"], "y": ["0", "long_x > 0 ? width : line_w"], "z": ["bottom_gap", "wall_lo"]},
    {"id": 22, "op": "array", "name": "bottom_strips_hi", "base": 21, "along": {"x": {"count": "long_x > 0 ? strips : 1", "start": "long_x > 0 ? long - line_w : 0", "step": "-strip_pitch"}, "y": {"count": "long_x > 0 ? 1 : strips", "start": "long_x > 0 ? 0 : long - line_w", "step": "-strip_pitch"}}},
    {"id": 23, "op": "box", "name": "bottom_strip_mid", "x": ["long_x > 0 ? strip_mid : 0", "long_x > 0 ? strip_mid + line_w : length"], "y": ["long_x > 0 ? 0 : strip_mid", "long_x > 0 ? width : strip_mid + line_w"], "z": ["bottom_gap", "wall_lo"]},
    {"id": 24, "op": "box", "name": "bottom_border_out", "x": ["0", "length"], "y": ["0", "width"], "z": ["bottom_gap", "wall_lo"]},
    {"id": 25, "op": "box", "name": "bottom_border_in", "x": ["line_w", "length - line_w"], "y": ["line_w", "width - line_w"], "z": ["-1", "height + 1"]},
    {"id": 26, "op": "cut", "name": "bottom_border", "base": 24, "tools": [25]},
    {"id": 27, "op": "fuse", "name": "bottom_interface", "of": [20, 22, 23, 26]},
    {"id": 28, "op": "box", "name": "top_strip_lo", "x": ["0", "long_x > 0 ? line_w : length"], "y": ["0", "long_x > 0 ? width : line_w"], "z": ["wall_hi", "height - interface_gap"]},
    {"id": 29, "op": "array", "name": "top_strips_lo", "base": 28, "along": {"x": {"count": "long_x > 0 ? strips : 1", "start": "long_x > 0 ? 0 : 0", "step": "strip_pitch"}, "y": {"count": "long_x > 0 ? 1 : strips", "start": "long_x > 0 ? 0 : 0", "step": "strip_pitch"}}},
    {"id": 30, "op": "box", "name": "top_strip_hi", "x": ["0", "long_x > 0 ? line_w : length"], "y": ["0", "long_x > 0 ? width : line_w"], "z": ["wall_hi", "height - interface_gap"]},
    {"id": 31, "op": "array", "name": "top_strips_hi", "base": 30, "along": {"x": {"count": "long_x > 0 ? strips : 1", "start": "long_x > 0 ? long - line_w : 0", "step": "-strip_pitch"}, "y": {"count": "long_x > 0 ? 1 : strips", "start": "long_x > 0 ? 0 : long - line_w", "step": "-strip_pitch"}}},
    {"id": 32, "op": "box", "name": "top_strip_mid", "x": ["long_x > 0 ? strip_mid : 0", "long_x > 0 ? strip_mid + line_w : length"], "y": ["long_x > 0 ? 0 : strip_mid", "long_x > 0 ? width : strip_mid + line_w"], "z": ["wall_hi", "height - interface_gap"]},
    {"id": 33, "op": "box", "name": "top_border_out", "x": ["0", "length"], "y": ["0", "width"], "z": ["wall_hi", "height - interface_gap"]},
    {"id": 34, "op": "box", "name": "top_border_in", "x": ["line_w", "length - line_w"], "y": ["line_w", "width - line_w"], "z": ["-1", "height + 1"]},
    {"id": 35, "op": "cut", "name": "top_border", "base": 33, "tools": [34]},
    {"id": 36, "op": "fuse", "name": "top_interface", "of": [29, 31, 32, 35]},
    {"id": 37, "op": "fuse", "name": null, "of": [14, 17, 18, 27, 36]}
  ]
}
